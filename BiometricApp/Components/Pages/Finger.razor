@page "/fingerprint"
@using BiometricApp.Natives
@inject BiometricApp.Services.ScannerService ScannerService
@inject BiometricApp.Services.ImageService ImageService


<h3>Fingerprint Device</h3>





<div class="wrapper">

    <!-- HEADER -->
    <div class="header">
        Data Capturing System
    </div>

    <div class="content">

        <!-- LEFT PANEL -->
        <div class="left-panel">
            <div class="d-flex gap-3 mb-2">
                <button class="btn btn-success" @onclick="StartScanLeft">Scan Left 4</button>
                <button class="btn btn-success" @onclick="StartScanLeftRight">Scan Right 4</button>
                <button class="btn btn-success" @onclick="StartScanLeftThum">Scan Thumb 2</button>
            </div>
            <p>@message</p>

          @*   <div class="finger-preview">
                @if (!string.IsNullOrEmpty(CurrentImage))
                {
                    <img src="@($"data:image/png;base64,{CurrentImage}")" />
                }
                else
                {
                    <img src="images/fingerprint.png" />
                }
            </div> *@

           @*  <p class="mt-2 fw-bold">@CurrentFingerName</p>

            <button class="btn capture-btn" @onclick="Capture">
                Capture
            </button>

            <button class="btn next-btn" @onclick="NextFinger">
                Next
            </button> *@
        </div>

        <!-- RIGHT PANEL -->
        <div class="right-panel">

            <!-- HAND IMAGES -->
            <div class="hands">
                <img src="images/left-finger2.jpg" class="hand-img" />
                <img src="images/right-finger2.jpg" class="hand-img" />
            </div>

            <div class="slots-row">

                <!-- LEFT HAND -->
                <div class="slots">
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="slot @(GetSlotClass(i))">
                            @if (!string.IsNullOrEmpty(Fingerprints[i]))
                            {
                                <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="finger-img" />
                            }
                        </div>
                    }
                </div>

                <!-- RIGHT HAND -->
                <div class="slots">
                    @for (int i = 5; i < 10; i++)
                    {
                        <div class="slot @(GetSlotClass(i))">
                            @if (Fingerprints[i] != null)
                            {
                                <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="finger-img" />
                            }
                        </div>
                    }
                </div>

            </div>

        </div>

    </div>
</div>

@code {

    string message = "";

    // Start scan
    private async Task StartScanLeft()
    {
        try
        {
            message = "Finger Capture Started.....";
            var result = await ScannerService.CaptureFingerprintLeft();

            message = result
            ? "Fingerprint captured and saved ✅"
            : "Fingerprint capture failed ❌";

            LoadLeftFourFingerprints();
        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }


    private async Task StartScanLeftRight() 
    {
        try
        {
            message = "Finger Capture Started.....";
            var result = await ScannerService.CaptureFingerprintRight();

            message = result
            ? "Fingerprint captured and saved ✅"
            : "Fingerprint capture failed ❌";

            LoadRightFourFingerprints();
        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }
    private async Task StartScanLeftThum()
    {
        try
        {
            message = "Finger Capture Started.....";
            var result = await ScannerService.CaptureFingerprintThum();

            message = result
            ? "Fingerprint captured and saved ✅"
            : "Fingerprint capture failed ❌";

            LoadTumTwoFingerprints();
        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }


    private void LoadLeftFourFingerprints()
    {
        string folder = @"C:\Biometric_Finger";

        string[] files =
        {
        "left_index_Left_Index.bmp",
        "left_middle_Left_Index.bmp",
        "left_ring_Left_Index.bmp",
        "left_little_Left_Index.bmp"
    };

        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(folder, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[i + 1] = Convert.ToBase64String(bytes);
            }
        }

        CurrentImage = Fingerprints[1];
        currentIndex = 1;
    }

    private void LoadRightFourFingerprints()
    {
        string folder = @"C:\Biometric_Finger";

        string[] files =
        {
        "right_index_Right_Index.bmp",
        "right_middle_Right_Index.bmp",
        "right_ring_Right_Index.bmp",
        "right_little_Right_Index.bmp"
    };

        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(folder, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[i + 6] = Convert.ToBase64String(bytes);
            }
        }

        // CurrentImage = Fingerprints[5];
        // currentIndex = 5;
    }

    private void LoadTumTwoFingerprints()
    {
        string folder = @"C:\Biometric_Finger";

        string[] files =
        {
            "thum_left_Left_Thumb.bmp",
            "thum_right_Left_Thumb.bmp"
     };

        int j = 0;
        for (int i = 0; i < files.Length; i++)
        {

            string path = Path.Combine(folder, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[j] = Convert.ToBase64String(bytes);
                j = 5;
            }
        }

        // CurrentImage = Fingerprints[5];
        // currentIndex = 5;
    }

    // Finger order
    private string[] Fingers = new[]
    {
        "Left Thumb", "Left Index", "Left Middle", "Left Ring", "Left Little",
        "Right Thumb", "Right Index", "Right Middle", "Right Ring", "Right Little"
    };

    private int currentIndex = 0;

    // Store captured fingerprints (10 fingers)
    private string[] Fingerprints = new string[10];

    private string CurrentImage;

    private string CurrentFingerName => currentIndex < Fingers.Length
        ? $"Scan your {Fingers[currentIndex]} finger"
        : "All fingers captured";

    // Capture button
    private void Capture()
    {
        // TODO: Replace with real SDK capture
        var base64 = GetDummyImage();

        Fingerprints[currentIndex] = base64;
        CurrentImage = base64;
    }

    // Next button
    private void NextFinger()
    {
        if (currentIndex < Fingers.Length - 1)
        {
            currentIndex++;
            CurrentImage = Fingerprints[currentIndex];
        }
    }

    // Highlight active slot
    private string GetSlotClass(int index)
    {
        if (index == currentIndex)
            return "active-finger";

        return "";
    }

    // Dummy image for testing
    private string GetDummyImage()
    {
        var path = Path.Combine("wwwroot/images/fingerprint.png");
        var bytes = File.ReadAllBytes(path);
        return Convert.ToBase64String(bytes);
    }
}

<style>

    .finger-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .preview-img {
        width: 220px;
        height: 220px;
        object-fit: contain;
    }
    .wrapper {
        width: 100%;
        min-height: 100vh; /* full screen height */
        background: #f4f6f9;
        padding: 20px;
        border: 1px solid #ccc;
        border-radius: 8px;
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
    }

    .header {
        background: #3b63a3;
        color: white;
        text-align: center;
        padding: 12px;
        font-weight: bold;
        font-size: 20px;
        margin-bottom: 20px;
    }

    .content {
        display: flex;
        justify-content: space-between;
    }

    /* LEFT PANEL */
    .left-panel {
        width: 30%;
    }

    .finger-preview {
        width: 150px;
        height: 150px;
        border: 2px solid #3b63a3;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 15px;
        border-radius: 8px;
    }

        .finger-preview img {
            max-width: 100%;
        }

    .capture-btn {
        background: #3b63a3;
        color: white;
        margin-top: 10px;
        width: 100%;
    }

    .next-btn {
        background: gray;
        color: white;
        margin-top: 10px;
        width: 100%;
    }

    /* RIGHT PANEL */
    .right-panel {
        width: 65%;
        text-align: center;
    }

    .hands {
        display: flex;
        justify-content: space-around;
        margin-bottom: 20px;
    }

    .hand-img {
        width: 180px;
    }

    /* SLOTS */
    .slots-row {
        display: flex;
        gap: 40px; /* space between left & right hand */
        justify-content: center;
        width: 100%;
    }

    /* Each group (5 fingers) */
    .slots {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 10px;
        width: 100%;
    }

    /* Slot styling */
    .slot {
        height: 80px;
        border: 2px solid #3b63a3;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .slot img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .active-finger {
        background: #4caf50;
        border-color: #4caf50;
    }
</style>
