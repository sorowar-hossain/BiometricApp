@page "/fingerprint"
@using BiometricApp.Models
@using BiometricApp.Natives
@using BiometricApp.Services
@inject BiometricApp.Services.ScannerService ScannerService
@inject BiometricApp.Services.ApiService ApiService
@inject LocalStorageService LocalStorageService
@inject NavigationManager Navigation
@inject UserSessionService SessionService

<div class="container-fluid">

    <div class="row g-3">

        <!-- LEFT SIDE : VIDEO -->
        <div class="col-md-4">

            <div class="video-panel">

                <div class="video-box">

                    @if (!string.IsNullOrWhiteSpace(ScannerService.CurrentFrameBase64))
                    {
                        <img src="@ScannerService.CurrentFrameBase64"
                             class="live-video" />
                    }
                    else
                    {
                        <div class="camera-placeholder">
                            Fingerprint Preview
                        </div>
                    }

                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(ScannerService.message))
            {
                <div class="capturing_status">
                    <span style="font-size:15px;font-weight:bold;">@ScannerService.message</span>
                </div>
            }
            
    </div>

        <!-- RIGHT SIDE -->
        <div class="col-md-8">

            <!-- LEFT 4 -->
            <div class="scan-section">

                <div class="slots">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="slot @(GetSlotClass(i))">

                            <div class="finger-label">
                                @GetFingerLabel(i)
                            </div>

                            @if (!string.IsNullOrEmpty(Fingerprints[i]))
                            {
                                <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")"
                                     class="finger-img" />
                            }

                        </div>
                    }
                </div>

                <button class="btn btn-success mt-2"
                        @onclick="StartScanLeft"
                        disabled="@(isProcessing)">
                    Scan Left 4
                </button>

            </div>

            <!-- RIGHT 4 -->
            <div class="scan-section mt-4">

                <div class="slots">
                    @for (int i = 6; i < 10; i++)
                    {
                        <div class="slot @(GetSlotClass(i))">

                            <div class="finger-label">
                                @GetFingerLabel(i)
                            </div>

                            @if (!string.IsNullOrEmpty(Fingerprints[i]))
                            {
                                <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")"
                                     class="finger-img" />
                            }

                        </div>
                    }
                </div>

                <button class="btn btn-success mt-2"
                        @onclick="StartScanRight"
                        disabled="@(isProcessing)">
                    Scan Right 4
                </button>

            </div>

            <!-- THUMBS -->
            <div class="thumb-section mt-4">

                <div class="slots thumb-slots">

                    <!-- LEFT THUMB -->
                    <div class="slot @(GetSlotClass(4))">

                        <div class="finger-label">LT</div>

                        @if (!string.IsNullOrEmpty(Fingerprints[4]))
                        {
                            <img src="@($"data:image/bmp;base64,{Fingerprints[4]}")"
                                 class="finger-img" />
                        }

                    </div>

                    <!-- RIGHT THUMB -->
                    <div class="slot @(GetSlotClass(5))">

                        <div class="finger-label">RT</div>

                        @if (!string.IsNullOrEmpty(Fingerprints[5]))
                        {
                            <img src="@($"data:image/bmp;base64,{Fingerprints[5]}")"
                                 class="finger-img" />
                        }

                    </div>

                </div>

                <div class="thumb-action-row mt-3">

                    <!-- LEFT EMPTY -->
                    <div></div>

                    <!-- CENTER BUTTON -->
                    <div class="text-center">
                        <button class="btn btn-success"
                                @onclick="StartScanThums"
                                disabled="@(isProcessing)">
                            Scan Thumb 2
                        </button>
                    </div>

                    <!-- RIGHT SAVE -->
                    <div class="text-end">
                        <button class="btn btn-success save-btn"
                                @onclick="Save"
                                disabled="@(!IsAllCompleted() || isProcessing)">
                            <i class="bi bi-check2-circle me-1"></i>Save
                        </button>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@code {
    bool lFingerDone = false, rFingerDone = false, tFingerDone = false;

    string leftImage = "images/left-finger.png";
    string rightImage = "images/right-finger.png";

    string folder = AppSettings.BaseFolder;
    private List<MemberDropdown> members = new();
    private string selectedMemberId = "BIO123456789";
    bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        selectedMemberId = SessionService.User.PersonUniqueId;
        ScannerService.message = "";
        // members = await LocalStorageService.GetMembersForDropdownAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        string? memberId = query["id"];

        if (!string.IsNullOrEmpty(memberId))
        {
            selectedMemberId = memberId;
        }
        selectedMemberId = "BIO123456789";
    }

    private bool IsAllCompleted()
    {
        return lFingerDone && rFingerDone && tFingerDone;
    }

    private async Task Save()
    {
        
    
    }


    private async Task GoNext()
    {
        if (isProcessing) return;

        if (!IsAllCompleted())
        {
            ScannerService.message = "Please complete all fingerprint scans first";
            return;
        }

        isProcessing = true;

        try
        {
            ScannerService.message = "Moving to iris capture...";
            StateHasChanged();

            await Task.Delay(500);

            Navigation.NavigateTo($"/iris-capture?id={selectedMemberId}");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void SelectMember(MemberDropdown item)
    {
        selectedMemberId = item.PersonUniqueId;
    }


    void ChangeImage()
    {
        if (lFingerDone == true && rFingerDone == true && tFingerDone == true)
        {
            leftImage = "images/LBSelected.png";
            rightImage = "images/RBSelected.png";
        }

        else if (lFingerDone == true && rFingerDone == false && tFingerDone == false)
        {
            leftImage = "images/L4Selected.png";
            rightImage = "images/right-finger.png";
        }

        else if (lFingerDone == true && rFingerDone == true && tFingerDone == false)
        {
            leftImage = "images/L4Selected.png";
            rightImage = "images/R4Selected.png";
        }

        else if (lFingerDone == false && rFingerDone == false && tFingerDone == true)
        {
            leftImage = "images/LTSelected.png";
            rightImage = "images/RTSelected.png";
        }

        else if (lFingerDone == true && rFingerDone == false && tFingerDone == true)
        {
            leftImage = "images/LBSelected.png";
            rightImage = "images/RTSelected.png";
        }

        else if (lFingerDone == false && rFingerDone == true && tFingerDone == true)
        {
            leftImage = "images/LTSelected.png";
            rightImage = "images/RBSelected.png";
        }

        else if (lFingerDone == false && rFingerDone == true && tFingerDone == false)
        {
            leftImage = "images/left-finger.png";
            rightImage = "images/R4Selected.png";
        }


        else
        {
            leftImage = "images/left-finger.png";
            rightImage = "images/right-finger.png";
        }

    }

    // Start scan
    private async Task StartScanLeft()
    {
        try
        {
            var result = false;
            string imagePath = Path.Combine(folder, selectedMemberId);
            ScannerService.message = "Capturing left finger.....";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);

            if (!ScannerService.reScan)
            {
                result = await ScannerService.CaptureFingerprintLeft(selectedMemberId);
                ScannerService.message = result
                ? "Left Fingerprint captured and saved ✅ To " + imagePath
                : ScannerService.message;
            }
            else
            {
                StateHasChanged();
                ScannerService.message = "Recapturing left finger.....";
                ScannerService.reScan = false;
                await StartScanLeft();
            }
            if (result)
            {
                lFingerDone = true;
                if (!rFingerDone)
                    currentIndex = 6;
                else if (!tFingerDone)
                    currentIndex = 4;
                LoadLeftFourFingerprints(imagePath);
                ChangeImage();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ScannerService.message = $"Exception: {ex.Message}";
        }
        StateHasChanged();
    }


    private async Task StartScanRight()
    {
        try
        {
            var result = false;
            string imagePath = Path.Combine(folder, selectedMemberId);
            if (string.IsNullOrWhiteSpace(selectedMemberId))
            {
                return;
            }
            ScannerService.message = "Capturing right finger.....";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);

            if (!ScannerService.reScan)
            {
                result = await ScannerService.CaptureFingerprintRight(selectedMemberId);
                ScannerService.message = result
                ? "Right Fingerprint captured and saved ✅ To " + imagePath
                : ScannerService.message;
            }
            else
            {
                StateHasChanged();
                ScannerService.message = "Recapturing right finger.....";
                ScannerService.reScan = false;
                await StartScanRight();
            }
            if (result)
            {
                rFingerDone = true;
                if (!lFingerDone)
                    currentIndex = 0;
                else if (!tFingerDone)
                    currentIndex = 4;
                LoadRightFourFingerprints(imagePath);
                ChangeImage();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ScannerService.message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }
    private async Task StartScanThums()
    {
        try
        {
            var result = false;
            string imagePath = Path.Combine(folder, selectedMemberId);
            if (string.IsNullOrWhiteSpace(selectedMemberId))
            {
                return;
            }
            ScannerService.message = "Capturing both thumbs.....";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);

            if (!ScannerService.reScan)
            {
                result = await ScannerService.CaptureFingerprintThumb(selectedMemberId);
                ScannerService.message = result
                ? "Thums Fingerprint captured and saved ✅ To " + imagePath
                : ScannerService.message;
            }
            else
            {
                StateHasChanged();
                ScannerService.message = "Recapturing Thumb finger.....";
                ScannerService.reScan = false;
                await StartScanThums();
            }


            if (result)
            {
                tFingerDone = true;
                if (!lFingerDone)
                    currentIndex = 0;
                else if (!rFingerDone)
                    currentIndex = 6;
                LoadThumbTwoFingerprints(imagePath);
                ChangeImage();
                StateHasChanged();
            }

        }
        catch (Exception ex)
        {
            ScannerService.message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }


    private void LoadLeftFourFingerprints(string imagePath)
    {
        string[] files =
        {
            "l_Left_Little_Left_Little.bmp",
            "l_Left_Ring_Left_Ring.bmp",
            "l_Left_Middle_Left_Middle.bmp",
            "l_Left_Index_Left_Index.bmp"

    };

        for (int i = 0; i < files.Length; i++)
        {

            string path = Path.Combine(imagePath, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[i] = Convert.ToBase64String(bytes);
            }
        }


    }

    private void LoadRightFourFingerprints(string imagePath)
    {

        string[] files =
        {
        "r_Right_Index_Right_Index.bmp",
        "r_Right_Middle_Right_Middle.bmp",
        "r_Right_Ring_Right_Ring.bmp",
        "r_Right_Little_Right_Little.bmp"
    };

        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(imagePath, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[i + 6] = Convert.ToBase64String(bytes);
            }
        }

        // CurrentImage = Fingerprints[5];
        // currentIndex = 5;
    }

    private void LoadThumbTwoFingerprints(string imagePath)
    {

        string[] files =
        {
            "l_Left_Thumb_Left_Thumb.bmp",
            "r_Right_Thumb_Right_Thumb.bmp"
     };

        int j = 4;
        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(imagePath, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[j] = Convert.ToBase64String(bytes);
                j = 5;
            }
        }

    }

    private async Task SaveFinger()
    {
        try
        {

            var users = await ApiService.GetUsersAsync();

            foreach (var user in users)
            {
                Console.WriteLine(user);
            }
            ScannerService.message = "Finger Saved";
            //LoadTumTwoFingerprints();
        }
        catch (Exception ex)
        {
            ScannerService.message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }


    private string GetFingerLabel(int index)
    {
        return index switch
        {
            0 => "LL", // Left Little
            1 => "LR", // Left Ring
            2 => "LM", // Left Middle
            3 => "LI", // Left Index
            4 => "LT", // Left Thumb

            5 => "RT", // Right Thumb
            6 => "RI", // Right Index
            7 => "RM", // Right Middle
            8 => "RR", // Right Ring
            9 => "RL", // Right Little

        };
    }



    private int currentIndex = 0;

    // Store captured fingerprints (10 fingers)
    private string[] Fingerprints = new string[10];



    // Highlight active slot
    private string GetSlotClass(int index)
    {
        if (index == currentIndex)
            return "active-finger";

        return "";
    }

    protected override void OnInitialized()
    {
        ScannerService.OnFrameUpdated += RefreshFrame;
    }

    private void RefreshFrame()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ScannerService.OnFrameUpdated -= RefreshFrame;
    }
}

<style>
    .video-panel {
        width: 100%;
    }

    .video-box {
        width: 100%;
        height: 450px;
        border: 2px solid #dcdcdc;
        border-radius: 12px;
        background: #f8f8f8;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .capturing_status {
        width: 100%;
        border: 2px solid #dcdcdc;
        border-radius: 12px;
        background: #f8f8f8;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-top: 15px;
        padding: 10px;
        text-align: center;
    }

    .live-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .camera-placeholder {
        color: #777;
        font-size: 18px;
        text-align: center;
    }

    .scan-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
    }

    .slots {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .slot {
        position: relative;
        width: 100%;
        height: 140px;
        border: 2px solid #3b63a3;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #fff;
    }

    .finger-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .finger-label {
        position: absolute;
        top: 2px;
        left: 2px;
        background: rgba(255,255,255,.9);
        padding: 2px 5px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: bold;
    }

    .thumb-section {
        width: 100%;
    }

    .thumb-slots {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
    }

        .thumb-slots .slot {
            width: 220px;
        }

    .thumb-action-row {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
    }

        .thumb-action-row .text-center {
            text-align: center;
        }

        .thumb-action-row .text-end {
            text-align: right;
        }

    .save-btn {
        min-width: 120px;
    }

    /* ---------- Tablet ---------- */
    @@media (max-width: 992px) {
        .video-box

    {
        height: 350px;
    }

    .slots {
        grid-template-columns: repeat(2, 1fr);
    }

    }

    /* ---------- Mobile ---------- */
    @@media (max-width: 768px) {
        .video-box

    {
        height: 250px;
    }

    .slots {
        grid-template-columns: repeat(2, 1fr);
    }

    .slot {
        height: 120px;
    }

    .thumb-action-row {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .thumb-action-row .text-center,
        .thumb-action-row .text-end {
            width: 100%;
            text-align: center;
        }

        .thumb-action-row button {
            width: 220px;
        }

    }

    /* ---------- Small Mobile ---------- */
    @@media (max-width: 576px) {
        .slots

    {
        grid-template-columns: 1fr;
    }

    .slot {
        height: 120px;
    }

    .thumb-slots {
        flex-direction: column;
        align-items: center;
    }

        .thumb-slots .slot {
            width: 100%;
            max-width: 220px;
        }

    .video-box {
        height: 220px;
    }

    }
</style>
