@page "/fingerprint"
@using BiometricApp.Natives
@inject BiometricApp.Services.ScannerService ScannerService
@inject BiometricApp.Services.ImageService ImageService

<div class="wrapper">

    <!-- HEADER -->
    <div class="header">
        Data Capturing System
    </div>

    <div class="content">

        <!-- UPPER PANEL (images + slots) -->
        <div class="upper-panel">

            <!-- HAND IMAGES -->
            <div class="hands">

                <!-- LEFT HAND -->
                <div class="hand-container">
                    <div class="hand-title">Left Hand</div>
                    <img src="@leftImage" class="hand-img" />
                </div>

                <!-- RIGHT HAND -->
                <div class="hand-container">
                    <div class="hand-title">Right Hand</div>
                    <img src="@rightImage" class="hand-img" />
                </div>

            </div>

            <!-- SLOTS -->
            <div class="slots-row">

                <!-- LEFT HAND -->
                <div class="slots">
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="slot @(GetSlotClass(i))">
                            <div class="finger-label">@GetFingerLabel(i)</div>

                            @if (!string.IsNullOrEmpty(Fingerprints[i]))
                            {
                                <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="finger-img" />
                            }
                        </div>
                    }
                </div>

                <!-- RIGHT HAND -->
                <div class="slots">
                    @for (int i = 5; i < 10; i++)
                    {
                        <div class="slot @(GetSlotClass(i))">
                            <div class="finger-label">@GetFingerLabel(i)</div>

                            @if (!string.IsNullOrEmpty(Fingerprints[i]))
                            {
                                <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="finger-img" />
                            }
                        </div>
                    }
                </div>

            </div>

        </div>

        <!-- LOWER PANEL (buttons) -->
        <div class="bottom-panel">
            <div class="d-flex gap-3 mb-2">
                <button class="btn btn-success" @onclick="StartScanLeft">Scan Left 4</button>
                <button class="btn btn-success" @onclick="StartScanRight">Scan Right 4</button>
                <button class="btn btn-success" @onclick="StartScanThums">Scan Thumb 2</button>
                <button class="btn btn-primary" @onclick="SaveFinger">Save</button>
            </div>
            <p>@message</p>
        </div>

    </div>
</div>

@code {

    string message = "";
    bool lFingerDone = false, rFingerDone = false, tFingerDone = false;

    string leftImage = "images/left-finger.png";
    string rightImage = "images/right-finger.png";

    void ChangeImage()
    {
        if (lFingerDone == true && rFingerDone == true && tFingerDone == true)
        {
            leftImage = "images/LBSelected.png";
            rightImage = "images/RBSelected.png";
        }

        else if (lFingerDone == true && rFingerDone == false && tFingerDone == false)
        {
            leftImage = "images/L4Selected.png";
            rightImage = "images/right-finger.png";
        }

        else if (lFingerDone == true && rFingerDone == true && tFingerDone == false)
        {
            leftImage = "images/L4Selected.png";
            rightImage = "images/R4Selected.png";
        }

        else if (lFingerDone == false && rFingerDone == false && tFingerDone == true)
        {
            leftImage = "images/LTSelected.png";
            rightImage = "images/RTSelected.png";
        }

        else if (lFingerDone == true && rFingerDone == false && tFingerDone == true)
        {
            leftImage = "images/LBSelected.png";
            rightImage = "images/RTSelected.png";
        }

        else if (lFingerDone == false && rFingerDone == true && tFingerDone == true)
        {
            leftImage = "images/LTSelected.png";
            rightImage = "images/RBSelected.png";
        }

        else if (lFingerDone == false && rFingerDone == true && tFingerDone == false)
        {
            leftImage = "images/left-finger.png";
            rightImage = "images/R4Selected.png";
        }


        else
        {
            leftImage = "images/left-finger.png";
            rightImage = "images/right-finger.png";
        }

    }

    // Start scan
    private async Task StartScanLeft()
    {
        try
        {
            message = "Capturing left finger.....";
            // Force UI update immediately
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);
            var result = await ScannerService.CaptureFingerprintLeft();

            message = result
            ? "Fingerprint captured and saved ✅"
            : "Fingerprint capture failed ❌";

            LoadLeftFourFingerprints();
            if (result)
            {
                lFingerDone = true;
                if (!rFingerDone)
                    currentIndex = 6;
                else if (!tFingerDone)
                    currentIndex = 4;
                ChangeImage();
            }

          

        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();

    }


    private async Task StartScanRight()
    {
        try
        {
            message = "Capturing right finger.....";
            // Force UI update immediately
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);
            var result = await ScannerService.CaptureFingerprintRight();

            message = result
            ? "Fingerprint captured and saved ✅"
            : "Fingerprint capture failed ❌";

            LoadRightFourFingerprints();
            if (result)
            {
                rFingerDone = true;
                if (!lFingerDone)
                    currentIndex = 0;
                else if (!tFingerDone)
                    currentIndex = 4;
                ChangeImage();
            }
          
        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }
    private async Task StartScanThums()
    {
        try
        {
            message = "Capturing both thumbs.....";
            // Force UI update immediately
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);
            var result = await ScannerService.CaptureFingerprintThum();

            message = result
            ? "Fingerprint captured and saved ✅"
            : "Fingerprint capture failed ❌";

            LoadTumTwoFingerprints();

            if (result)
            {
                tFingerDone = true;
                if (!lFingerDone)
                    currentIndex = 0;
                else if (!rFingerDone)
                    currentIndex = 6;
                ChangeImage();
            }
            
        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }


    private void LoadLeftFourFingerprints()
    {
        string folder = @"C:\Biometric_Finger";

        string[] files =
        {
            "l_Left_Little.bmp",
            "l_Left_Ring.bmp",
            "l_Left_Middle.bmp",
            "l_Left_Index.bmp"

    };

        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(folder, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[i] = Convert.ToBase64String(bytes);
            }
        }


    }

    private void LoadRightFourFingerprints()
    {
        string folder = @"C:\Biometric_Finger";

        string[] files =
        {
        "r_Right_Index.bmp",
        "r_Right_Middle.bmp",
        "r_Right_Ring.bmp",
        "r_Right_Little.bmp"
    };

        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(folder, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[i + 6] = Convert.ToBase64String(bytes);
            }
        }

        // CurrentImage = Fingerprints[5];
        // currentIndex = 5;
    }

    private void LoadTumTwoFingerprints()
    {
        string folder = @"C:\Biometric_Finger";

        string[] files =
        {
            "l_Left_Thumb.bmp",
            "r_Right_Thumb.bmp"
     };

        int j = 4;
        for (int i = 0; i < files.Length; i++)
        {

            string path = Path.Combine(folder, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[j] = Convert.ToBase64String(bytes);
                j = 5;
            }
        }

    }

    private async Task SaveFinger()
    {
        try
        {
            message = "Finger Saved";
            LoadTumTwoFingerprints();
        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }


    private string GetFingerLabel(int index)
    {
        return index switch
        {
            0 => "LL", // Left Little
            1 => "LR", // Left Ring
            2 => "LM", // Left Middle
            3 => "LI", // Left Index
            4 => "LT", // Left Thumb

            5 => "RT", // Right Thumb
            6 => "RI", // Right Index
            7 => "RM", // Right Middle
            8 => "RR", // Right Ring
            9 => "RL", // Right Little

        };
    }



    private int currentIndex = 0;

    // Store captured fingerprints (10 fingers)
    private string[] Fingerprints = new string[10];



    // Highlight active slot
    private string GetSlotClass(int index)
    {
        if (index == currentIndex)
            return "active-finger";

        return "";
    }


}

<style>
    body {
        margin: 0;
        padding: 0;
    }

    .wrapper {
        width: 100%;
        min-height: 100vh;
        background: #f4f6f9;
        padding: 20px;
        box-sizing: border-box;
    }

    /* HEADER */
    .header {
        background: #3b63a3;
        color: white;
        text-align: center;
        padding: 12px;
        font-weight: bold;
        font-size: 20px;
        margin-bottom: 15px;
    }

    /* MAIN LAYOUT */
    .content {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    /* UPPER PANEL */
    .upper-panel {
        text-align: center;
    }

    /* HAND IMAGES */
    .hands {
        display: flex;
        justify-content: center;
        gap: 40px;
        margin-bottom: 15px;
    }

    .hand-img {
        width: 160px;
    }

    /* SLOTS */
    .slots-row {
        display: flex;
        justify-content: center;
        gap: 20px;
    }

    .slots {
        display: grid;
        grid-template-columns: repeat(5, 70px);
        gap: 10px;
    }

    .slot {
        position: relative;
        width: 70px;
        height: 80px;
        border: 2px solid #3b63a3;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .finger-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .finger-label {
        position: absolute;
        top: 2px;
        left: 2px;
        font-size: 10px;
        font-weight: bold;
        background: rgba(255,255,255,0.8);
        padding: 1px 3px;
        border-radius: 3px;
    }

    .active-finger {
        background: #4caf50;
        border-color: #4caf50;
    }

    /* BOTTOM PANEL */
    .bottom-panel {
        position: sticky;
        bottom: 0;
        background: white;
        padding: 10px;
        border-top: 1px solid #ccc;
    }

        .bottom-panel .d-flex {
            justify-content: center;
            flex-wrap: wrap;
        }

    .hand-container {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hand-title {
        font-weight: bold;
        margin-bottom: 5px;
        color: #333;
        font-size: 14px;
    }

    .hand-title {
        font-weight: bold;
        margin-bottom: 6px;
        color: white;
        font-size: 13px;
        background: #3b63a3;
        padding: 3px 10px;
        border-radius: 12px;
    }
</style>
