@page "/fingerprint"
@using BiometricApp.Natives
@inject BiometricApp.Services.ScannerService ScannerService
@inject BiometricApp.Services.ImageService ImageService

<div class="wrapper">

    <!-- HEADER -->
    <div class="header">
        Data Capturing System
    </div>

    <div class="content">

        <!-- LEFT PANEL -->
        <div class="left-panel">
            <div class="d-flex gap-3 mb-2">
                <button class="btn btn-success" @onclick="StartScanLeft">Scan Left 4</button>
                <button class="btn btn-success" @onclick="StartScanRight">Scan Right 4</button>
                <button class="btn btn-success" @onclick="StartScanThums">Scan Thumb 2</button>
                <button class="btn btn-primary" @onclick="SaveFinger">Save</button>
            </div>
            <p>@message</p>

            @*   <div class="finger-preview">
                @if (!string.IsNullOrEmpty(CurrentImage))
                {
                    <img src="@($"data:image/png;base64,{CurrentImage}")" />
                }
                else
                {
                    <img src="images/fingerprint.png" />
                }
            </div> *@

            @*  <p class="mt-2 fw-bold">@CurrentFingerName</p>

            <button class="btn capture-btn" @onclick="Capture">
                Capture
            </button>

            <button class="btn next-btn" @onclick="NextFinger">
                Next
            </button> *@
        </div>

        <!-- RIGHT PANEL -->
        <div class="right-panel">

            <!-- HAND IMAGES -->
            <div class="hands">
                <img src="@leftImage" class="hand-img" />
                <img src="@rightImage" class="hand-img" />
            </div>

            <div class="slots-row">

                <!-- LEFT HAND -->
                <div class="slots">
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="slot @(GetSlotClass(i))">

                            <!-- Label -->
                            <div class="finger-label">@GetFingerLabel(i)</div>

                            @if (!string.IsNullOrEmpty(Fingerprints[i]))
                            {
                                <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="finger-img" />
                            }
                        </div>
                    }
                </div>

                <!-- RIGHT HAND -->
                <div class="slots">
                    @for (int i = 5; i < 10; i++)
                    {
                        <div class="slot @(GetSlotClass(i))">

                            <!-- Label -->
                            <div class="finger-label">@GetFingerLabel(i)</div>

                            @if (!string.IsNullOrEmpty(Fingerprints[i]))
                            {
                                <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="finger-img" />
                            }
                        </div>
                    }
                </div>

            </div>

        </div>

    </div>
</div>

@code {

    string message = "";
    bool lFingerDone = false, rFingerDone = false, tFingerDone = false;

    string leftImage = "images/left-finger.png";
    string rightImage = "images/right-finger.png";

    void ChangeImage()
    {
        if (lFingerDone == true && rFingerDone == true && tFingerDone == true)
        {
            leftImage = "images/LBSelected.png";
            rightImage = "images/RBSelected.png";
        }

        else if (lFingerDone == true && rFingerDone == false && tFingerDone == false)
        {
            leftImage = "images/L4Selected.png";
            rightImage = "images/right-finger.png";
        }

        else if (lFingerDone == true && rFingerDone == true && tFingerDone == false)
        {
            leftImage = "images/L4Selected.png";
            rightImage = "images/R4Selected.png";
        }

        else if (lFingerDone == false && rFingerDone == false && tFingerDone == true)
        {
            leftImage = "images/LTSelected.png";
            rightImage = "images/RTSelected.png";
        }

        else if (lFingerDone == true && rFingerDone == false && tFingerDone == true)
        {
            leftImage = "images/LBSelected.png";
            rightImage = "images/RTSelected.png";
        }

        else if (lFingerDone == false && rFingerDone == true && tFingerDone == true)
        {
            leftImage = "images/LTSelected.png";
            rightImage = "images/RBSelected.png";
        }


        else
        {
            leftImage = "images/left-finger.png";
            rightImage = "images/right-finger.png";
        }

    }

    // Start scan
    private async Task StartScanLeft()
    {
        try
        {
            message = "Capturing left finger.....";
            var result = await ScannerService.CaptureFingerprintLeft();

            message = result
            ? "Fingerprint captured and saved ✅"
            : "Fingerprint capture failed ❌";

            LoadLeftFourFingerprints();
           
            lFingerDone = true;
            if (!rFingerDone)
                currentIndex = 6;
            else if (!tFingerDone)
                currentIndex = 4;
            ChangeImage();
           
        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();

    }


    private async Task StartScanRight()
    {
        try
        {
            message = "Capturing right finger.....";
            var result = await ScannerService.CaptureFingerprintRight();

            message = result
            ? "Fingerprint captured and saved ✅"
            : "Fingerprint capture failed ❌";

            LoadRightFourFingerprints();
          
            rFingerDone = true;
            if (!lFingerDone)
                currentIndex = 0;
            else if (!tFingerDone)
                currentIndex = 4;
            ChangeImage();


        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }
    private async Task StartScanThums()
    {
        try
        {
            message = "Capturing both thumbs.....";
            var result = await ScannerService.CaptureFingerprintThum();

            message = result
            ? "Fingerprint captured and saved ✅"
            : "Fingerprint capture failed ❌";

            LoadTumTwoFingerprints();
   
            tFingerDone = true;
            if (!lFingerDone)
                currentIndex = 0;
            else if (!rFingerDone)
                currentIndex = 6;
            ChangeImage();
        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }


    private void LoadLeftFourFingerprints()
    {
        string folder = @"C:\Biometric_Finger";

        string[] files =
        {
            "l_Left_Little.bmp",
            "l_Left_Ring.bmp",
            "l_Left_Middle.bmp",
            "l_Left_Index.bmp"

    };

        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(folder, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[i] = Convert.ToBase64String(bytes);
            }
        }


    }

    private void LoadRightFourFingerprints()
    {
        string folder = @"C:\Biometric_Finger";

        string[] files =
        {
        "r_Right_Index.bmp",
        "r_Right_Middle.bmp",
        "r_Right_Ring.bmp",
        "r_Right_Little.bmp"
    };

        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(folder, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[i + 6] = Convert.ToBase64String(bytes);
            }
        }

        // CurrentImage = Fingerprints[5];
        // currentIndex = 5;
    }

    private void LoadTumTwoFingerprints()
    {
        string folder = @"C:\Biometric_Finger";

        string[] files =
        {
            "l_Left_Thumb.bmp",
            "r_Right_Thumb.bmp"
     };

        int j = 4;
        for (int i = 0; i < files.Length; i++)
        {

            string path = Path.Combine(folder, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[j] = Convert.ToBase64String(bytes);
                j = 5;
            }
        }

    }

    private async Task SaveFinger()
    {
        try
        {
            message = "Finger Saved";
            LoadTumTwoFingerprints();
        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }


    private string GetFingerLabel(int index)
    {
        return index switch
        {
            0 => "LL", // Left Little
            1 => "LR", // Left Ring
            2 => "LM", // Left Middle
            3 => "LI", // Left Index
            4 => "LT", // Left Thumb

            5 => "RT", // Right Thumb
            6 => "RI", // Right Index
            7 => "RM", // Right Middle
            8 => "RR", // Right Ring
            9 => "RL", // Right Little

        };
    }



    private int currentIndex = 0;

    // Store captured fingerprints (10 fingers)
    private string[] Fingerprints = new string[10];



    // Highlight active slot
    private string GetSlotClass(int index)
    {
        if (index == currentIndex)
            return "active-finger";

        return "";
    }


}

<style>


    .finger-label {
        position: absolute;
        top: 2px;
        left: 2px; /* tighter spacing */
        font-size: 11px; /* slightly smaller */
        font-weight: bold;
        color: #333;
        background: rgba(255,255,255,0.8);
        padding: 1px 3px; /* reduce padding */
        border-radius: 3px;
        z-index: 2;
        white-space: nowrap; /* prevent breaking */
    }

    .finger-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .finger-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .preview-img {
        width: 220px;
        height: 220px;
        object-fit: contain;
    }

    .wrapper {
        width: 100%;
        min-height: 100vh; /* full screen height */
        background: #f4f6f9;
        padding: 20px;
        border: 1px solid #ccc;
        border-radius: 8px;
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
    }

    .header {
        background: #3b63a3;
        color: white;
        text-align: center;
        padding: 12px;
        font-weight: bold;
        font-size: 20px;
        margin-bottom: 20px;
    }

    .content {
        display: flex;
        justify-content: space-between;
    }

    /* LEFT PANEL */
    .left-panel {
        width: 30%;
    }

    .finger-preview {
        width: 150px;
        height: 150px;
        border: 2px solid #3b63a3;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 15px;
        border-radius: 8px;
    }

        .finger-preview img {
            max-width: 100%;
        }

    .capture-btn {
        background: #3b63a3;
        color: white;
        margin-top: 10px;
        width: 100%;
    }

    .next-btn {
        background: gray;
        color: white;
        margin-top: 10px;
        width: 100%;
    }

    /* RIGHT PANEL */
    .right-panel {
        width: 65%;
        text-align: center;
    }

    .hands {
        display: flex;
        justify-content: space-around;
        margin-bottom: 20px;
    }

    .hand-img {
        width: 180px;
    }

    /* SLOTS */
    .slots-row {
        display: flex;
        gap: 20px; /* reduce from 40px */
        justify-content: center;
        width: 100%;
    }

    /* Each group (5 fingers) */
    .slots {
        display: grid;
        grid-template-columns: repeat(5, minmax(70px, 1fr));
        gap: 10px;
        width: 100%;
    }

    /* Slot styling */
    .slot {
        position: relative;
        width: 100%; /* ✅ responsive inside grid */
        height: 80px;
        border: 2px solid #3b63a3;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .slot img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .active-finger {
        background: #4caf50;
        border-color: #4caf50;
    }
</style>
