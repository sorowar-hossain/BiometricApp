@page "/fingerprint"
@using BiometricApp.Models
@using BiometricApp.Natives
@using BiometricApp.Services
@inject BiometricApp.Services.ScannerService ScannerService
@inject BiometricApp.Services.ApiService ApiService
@inject LocalStorageService LocalStorageService

<div class="content">
    <div class="top-row">

        <!-- Member Selection -->
        <div class="member-select">
            <label>Select Member</label>
            <select class="form-control" @bind="selectedMemberId">
                <option value="">-- Select Member --</option>
                @foreach (var item in members)
                {
                    <option value="@item.PersonUniqueId">
                        @item.FullName
                    </option>
                }
            </select>
        </div>

        

    </div>
    <div class="hands-wrapper">

        <!-- HAND IMAGES -->
        <div class="hands">
            <div class="hand-container">
                <div class="hand-title">Left Hand</div>
                <img src="@leftImage" class="hand-img" />
            </div>

            <div class="hand-container">
                <div class="hand-title">Right Hand</div>
                <img src="@rightImage" class="hand-img" />
            </div>
        </div>

    </div>

    <!-- 4 FINGERS ROW -->
    <div class="slots-row">

        <!-- LEFT 4 -->
        <div class="group">
            <div class="slots">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="slot @(GetSlotClass(i))">
                        <div class="finger-label">@GetFingerLabel(i)</div>

                        @if (!string.IsNullOrEmpty(Fingerprints[i]))
                        {
                            <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="finger-img" />
                        }
                    </div>
                }
            </div>

            <button class="btn btn-success mt-2" @onclick="StartScanLeft">
                Scan Left 4
            </button>
        </div>

        <!-- RIGHT 4 -->
        <div class="group">
            <div class="slots">
                @for (int i = 6; i < 10; i++)
                {
                    <div class="slot @(GetSlotClass(i))">
                        <div class="finger-label">@GetFingerLabel(i)</div>

                        @if (!string.IsNullOrEmpty(Fingerprints[i]))
                        {
                            <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="finger-img" />
                        }
                    </div>
                }
            </div>

            <button class="btn btn-success mt-2" @onclick="StartScanRight">
                Scan Right 4
            </button>
        </div>

    </div>

    <!-- THUMBS -->
    <div class="thumb-section">

        <div class="slots">
            <!-- LEFT THUMB -->
            <div class="slot @(GetSlotClass(4))">
                <div class="finger-label">LT</div>

                @if (!string.IsNullOrEmpty(Fingerprints[4]))
                {
                    <img src="@($"data:image/bmp;base64,{Fingerprints[4]}")" class="finger-img" />
                }
            </div>

            <!-- RIGHT THUMB -->
            <div class="slot @(GetSlotClass(5))">
                <div class="finger-label">RT</div>

                @if (!string.IsNullOrEmpty(Fingerprints[5]))
                {
                    <img src="@($"data:image/bmp;base64,{Fingerprints[5]}")" class="finger-img" />
                }
            </div>
        </div>

        <!-- Scan Thumb -->
        <button class="btn btn-success mt-2" @onclick="StartScanThums">
            Scan Thumb 2
        </button>

        <!-- ✅ SAVE BUTTON NOW HERE -->
       @*  <button class="btn btn-primary mt-2" @onclick="SaveFinger">
            Save
        </button> *@

        <!-- MESSAGE -->
        <p class="mt-2">@message</p>

    </div>
   

</div>

@code {

    string message = "";
    bool lFingerDone = false, rFingerDone = false, tFingerDone = false;

    string leftImage = "images/left-finger.png";
    string rightImage = "images/right-finger.png";

    string folder = AppSettings.BaseFolder;
    private List<MemberDropdown> members = new();
    private string selectedMemberId;

    protected override async Task OnInitializedAsync()
    {
        message = "";
        members = await LocalStorageService.GetMembersForDropdownAsync();
    }
    private void SelectMember(MemberDropdown item)
    {
        selectedMemberId = item.PersonUniqueId;
    }


    void ChangeImage()
    {
        if (lFingerDone == true && rFingerDone == true && tFingerDone == true)
        {
            leftImage = "images/LBSelected.png";
            rightImage = "images/RBSelected.png";
        }

        else if (lFingerDone == true && rFingerDone == false && tFingerDone == false)
        {
            leftImage = "images/L4Selected.png";
            rightImage = "images/right-finger.png";
        }

        else if (lFingerDone == true && rFingerDone == true && tFingerDone == false)
        {
            leftImage = "images/L4Selected.png";
            rightImage = "images/R4Selected.png";
        }

        else if (lFingerDone == false && rFingerDone == false && tFingerDone == true)
        {
            leftImage = "images/LTSelected.png";
            rightImage = "images/RTSelected.png";
        }

        else if (lFingerDone == true && rFingerDone == false && tFingerDone == true)
        {
            leftImage = "images/LBSelected.png";
            rightImage = "images/RTSelected.png";
        }

        else if (lFingerDone == false && rFingerDone == true && tFingerDone == true)
        {
            leftImage = "images/LTSelected.png";
            rightImage = "images/RBSelected.png";
        }

        else if (lFingerDone == false && rFingerDone == true && tFingerDone == false)
        {
            leftImage = "images/left-finger.png";
            rightImage = "images/R4Selected.png";
        }


        else
        {
            leftImage = "images/left-finger.png";
            rightImage = "images/right-finger.png";
        }

    }

    // Start scan
    private async Task StartScanLeft()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(selectedMemberId))
            {
                return;
            }

            message = "Capturing left finger.....";
            // Force UI update immediately
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);
            var result = await ScannerService.CaptureFingerprintLeft(selectedMemberId);
            string imagePath = Path.Combine(folder, selectedMemberId);
            message = result
            ? "Left Fingerprint captured and saved ✅ To " + imagePath
            : "Fingerprint capture failed ❌";

            
            LoadLeftFourFingerprints(imagePath);
            if (result)
            {
                lFingerDone = true;
                if (!rFingerDone)
                    currentIndex = 6;
                else if (!tFingerDone)
                    currentIndex = 4;
                ChangeImage();
            }

          

        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();

    }


    private async Task StartScanRight()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(selectedMemberId))
            {
                return;
            }

            message = "Capturing right finger.....";
            // Force UI update immediately
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);
            var result = await ScannerService.CaptureFingerprintRight(selectedMemberId);
            string imagePath = Path.Combine(folder, selectedMemberId);
            message = result
            ? "Right Fingerprint captured and saved ✅ To " + imagePath
            : "Fingerprint capture failed ❌";

            LoadRightFourFingerprints(imagePath);
            if (result)
            {
                rFingerDone = true;
                if (!lFingerDone)
                    currentIndex = 0;
                else if (!tFingerDone)
                    currentIndex = 4;
                ChangeImage();
            }
          
        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }
    private async Task StartScanThums()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(selectedMemberId))
            {
                return;
            }
            message = "Capturing both thumbs.....";
            // Force UI update immediately
            await InvokeAsync(StateHasChanged);
            await Task.Delay(100);
            var result = await ScannerService.CaptureFingerprintThum(selectedMemberId);
            string imagePath = Path.Combine(folder, selectedMemberId);
            message = result
            ? "Thums Fingerprint captured and saved ✅ To " + imagePath
            : "Fingerprint capture failed ❌";

            LoadThumbTwoFingerprints(imagePath);

            if (result)
            {
                tFingerDone = true;
                if (!lFingerDone)
                    currentIndex = 0;
                else if (!rFingerDone)
                    currentIndex = 6;
                ChangeImage();
            }
            
        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }


    private void LoadLeftFourFingerprints(string imagePath)
    {
        string[] files =
        {
            "l_Left_Little.bmp",
            "l_Left_Ring.bmp",
            "l_Left_Middle.bmp",
            "l_Left_Index.bmp"

    };

        for (int i = 0; i < files.Length; i++)
        {
            
            string path = Path.Combine(imagePath, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[i] = Convert.ToBase64String(bytes);
            }
        }


    }

    private void LoadRightFourFingerprints(string imagePath)
    {

        string[] files =
        {
        "r_Right_Index.bmp",
        "r_Right_Middle.bmp",
        "r_Right_Ring.bmp",
        "r_Right_Little.bmp"
    };

        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(imagePath, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[i + 6] = Convert.ToBase64String(bytes);
            }
        }

        // CurrentImage = Fingerprints[5];
        // currentIndex = 5;
    }

    private void LoadThumbTwoFingerprints(string imagePath)
    {
       
        string[] files =
        {
            "l_Left_Thumb.bmp",
            "r_Right_Thumb.bmp"
     };

        int j = 4;
        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(imagePath, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[j] = Convert.ToBase64String(bytes);
                j = 5;
            }
        }

    }

    private async Task SaveFinger()
    {
        try
        {
           
            var users = await ApiService.GetUsersAsync();

            foreach (var user in users)
            {
                Console.WriteLine(user);
            }
            message = "Finger Saved";
            //LoadTumTwoFingerprints();
        }
        catch (Exception ex)
        {
            message = $"Exception: {ex.Message}";
        }

        StateHasChanged();
    }


    private string GetFingerLabel(int index)
    {
        return index switch
        {
            0 => "LL", // Left Little
            1 => "LR", // Left Ring
            2 => "LM", // Left Middle
            3 => "LI", // Left Index
            4 => "LT", // Left Thumb

            5 => "RT", // Right Thumb
            6 => "RI", // Right Index
            7 => "RM", // Right Middle
            8 => "RR", // Right Ring
            9 => "RL", // Right Little

        };
    }



    private int currentIndex = 0;

    // Store captured fingerprints (10 fingers)
    private string[] Fingerprints = new string[10];



    // Highlight active slot
    private string GetSlotClass(int index)
    {
        if (index == currentIndex)
            return "active-finger";

        return "";
    }


}

<style>
    .member-select .form-control {
        width: 100%;
    }
    .top-row {
        display: flex;
        align-items: flex-start; /* aligns with titles */
        gap: 30px;
    }

    .member-select {
        width: 250px;
    }

  

    .hand-container {
        text-align: center;
    }

    body {
        margin: 0;
        padding: 0;
    }

    .wrapper {
        width: 100%;
        min-height: 100vh;
        background: #f4f6f9;
        padding: 20px;
        box-sizing: border-box;
    }

    /* HEADER */
    .header {
        background: #3b63a3;
        color: white;
        text-align: center;
        padding: 12px;
        font-weight: bold;
        font-size: 20px;
        margin-bottom: 15px;
    }

    /* MAIN LAYOUT */
    .content {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    /* UPPER PANEL */
    .upper-panel {
        text-align: center;
    }

    /* HAND IMAGES */
    .hands-wrapper {
        width: 100%;
        display: flex;
        justify-content: center; /* ✅ center whole block */
    }

    .hands {
        display: flex;
        justify-content: center; /* ✅ center inside */
        align-items: flex-start;
        gap: clamp(30px, 6vw, 80px); /* responsive spacing */
        flex-wrap: wrap; /* ✅ prevents breaking */
    }
    

    .hand-img {
        width: 160px;
    }

    /* SLOTS */
    .slots-row {
        display: flex;
        justify-content: center;
        gap: 20px;
    }

    .slots {
        display: grid;
        grid-template-columns: repeat(5, 70px);
        gap: 10px;
    }

    .slot {
        position: relative;
        width: 70px;
        height: 80px;
        border: 2px solid #3b63a3;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .finger-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .finger-label {
        position: absolute;
        top: 2px;
        left: 2px;
        font-size: 10px;
        font-weight: bold;
        background: rgba(255,255,255,0.8);
        padding: 1px 3px;
        border-radius: 3px;
    }

    .active-finger {
        background: #4caf50;
        border-color: #4caf50;
    }

    /* BOTTOM PANEL */
    .bottom-panel {
        position: sticky;
        bottom: 0;
        background: white;
        padding: 10px;
        border-top: 1px solid #ccc;
    }

        .bottom-panel .d-flex {
            justify-content: center;
            flex-wrap: wrap;
        }

    .hand-container {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hand-title {
        font-weight: bold;
        margin-bottom: 5px;
        color: #333;
        font-size: 14px;
    }

    .hand-title {
        font-weight: bold;
        margin-bottom: 6px;
        color: white;
        font-size: 13px;
        background: #3b63a3;
        padding: 3px 10px;
        border-radius: 12px;
    }

    .group {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .thumb-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 10px;
    }

        .thumb-section button {
            width: 180px;
        }

        .thumb-section .slots {
            display: flex;
            gap: 20px;
        }

        /* Make thumb bigger */
        .thumb-section .slot {
            width: 80px;
            height: 90px;
        }
    @@media (min-width: 600px) {
        .thumb-section .slot {
            width: 80px;
        }
    }
</style>
