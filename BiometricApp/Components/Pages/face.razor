@page "/face-capture"
@using BiometricApp.Models
@using BiometricApp.Services
@inject IJSRuntime JS
@inject FaceService FaceService
@inject LocalStorageService LocalStorageService

<div class="container-fluid biometric-container">

    <!-- Header -->
    <div class="header-bar text-center">
        <h4>Biometric Enrollment System</h4>
    </div>

    <div class="row mt-3">

        <!-- LEFT PANEL -->
        <div class="col-lg-3 col-md-4 col-sm-12 control-panel">

            <!-- Member Selection -->
            <div class="member-select">

                <label>Select Member</label>
                <select class="form-control" @bind="selectedMemberId">
                    <option value="">-- Select Member --</option>
                    @foreach (var item in members)
                    {
                        <option value="@item.PersonUniqueId">
                            @item.FullName
                        </option>
                    }
                </select>
            </div>

            @* <h6 class="panel-title">Camera Controls</h6>

            <div class="control-item">
                <label>Brightness</label>
                <input type="range" min="0" max="100" @bind="Brightness" class="form-range">
            </div>

            <div class="control-item">
                <label>Sharpness</label>
                <input type="range" min="0" max="100" @bind="Sharpness" class="form-range">
            </div>

            <div class="control-item">
                <label>Zoom</label>
                <input type="range" min="0" max="100" @bind="Zoom" class="form-range">
            </div> *@

            <div class="instructions">
                <h6>Capture Instructions</h6>
                <ul>
                    <li>Face centered inside frame</li>
                    <li>Good lighting required</li>
                    <li>No glasses or hats</li>
                    <li>Neutral expression</li>
                </ul>
            </div>

        </div>

        <!-- CAMERA PANEL -->
        <div class="col-lg-6 col-md-8 col-sm-12 text-center">

            <h6 class="panel-title">Live Camera</h6>

            <div class="camera-wrapper">

                <video id="video" autoplay></video>

                <!-- Face Guide -->
                <div class="face-guide"></div>

            </div>

            <div class="camera-buttons">

                <button class="btn btn-primary" @onclick="ToggleCamera">
                    <i class="bi @(CameraConnected ? "bi-camera-video-off" : "bi-camera-video")"></i>
                    @(CameraConnected ? " Close Camera" : " Open Camera")
                </button>

                <button class="btn btn-success"
                        @onclick="Capture"
                        disabled="@(!CameraConnected)">
                    <i class="bi bi-camera"></i>
                    Capture
                </button>

                <button class="btn btn-warning"
                        @onclick="Retake"
                        disabled="@string.IsNullOrEmpty(CapturedImage)">
                    <i class="bi bi-arrow-repeat"></i>
                    Retake
                </button>

            </div>

        </div>

        <!-- RIGHT PANEL -->
        <div class="col-lg-3 col-md-12 text-center preview-panel">

            <h6 class="panel-title">Captured Face</h6>

            <div class="preview-box">

                @if (!string.IsNullOrEmpty(CapturedImage))
                {
                    <img src="@CapturedImage" />
                }
                else
                {
                    <span class="placeholder">No Image</span>
                }

            </div>

            <label>Brightness</label>
            <input type="range" min="-100" max="100"
                   value="@Brightness"
                   disabled="@string.IsNullOrEmpty(CapturedImage)"
                   @oninput="async e => await ChangeBrightness(e.Value.ToString())" />

            <label>Rotate</label>
            <input type="range" min="-180" max="180"
                   value="@Rotation"
                   disabled="@string.IsNullOrEmpty(CapturedImage)"
                   @oninput="async e => await RotateImage(e.Value.ToString())" />

            <label>Zoom</label>
            <input type="range" min="1" max="3" step="0.1"
                   value="@ZoomLevel"
                   disabled="@string.IsNullOrEmpty(CapturedImage)"
                   @oninput="async e => await ZoomImage(e.Value.ToString())" />

            <button class="btn btn-secondary mt-2 w-100"
                    @onclick="Undo"
                    disabled="@string.IsNullOrEmpty(CapturedImage)">
                <i class="bi bi-arrow-counterclockwise me-2"></i>
                Undo
            </button>

            <button class="btn btn-success mt-3 w-100"
                    @onclick="SaveFace"
                    disabled="@string.IsNullOrEmpty(CapturedImage)">
                <i class="bi bi-save me-2"></i>
                Save Photo
            </button>

            <div class="status-box">
                <small>Status: @Status</small>
            </div>

        </div>

    </div>

</div>



@code {

    int Sharpness;
    int Zoom;

    int Brightness = 0;
    int Rotation = 0;
    double ZoomLevel = 1;

    string CapturedImage;
    string Status = "Idle";

    private string path = AppSettings.BaseFolder;
    private List<MemberDropdown> members = new();
    private string selectedMemberId;

    protected override async Task OnInitializedAsync()
    {

        members = await LocalStorageService.GetMembersForDropdownAsync();
    }
    private void SelectMember(MemberDropdown item)
    {
        selectedMemberId = item.PersonUniqueId;
    }

    async Task ConnectCamera()
    {
        await JS.InvokeVoidAsync("webcam.start");
        Status = "Camera connected";
    }

    async Task Capture()
    {

        if (string.IsNullOrWhiteSpace(selectedMemberId))
        {
            return;
        }
        CapturedImage = await JS.InvokeAsync<string>("webcam.capture");

        Brightness = 0;
        Rotation = 0;
        ZoomLevel = 1;

        Status = "Face captured";
    }

    void Retake()
    {
        CapturedImage = null;
        Status = "Retake photo";

        Brightness = 0;
        Rotation = 0;
        ZoomLevel = 1;
    }

    async Task DisconnectCamera()
    {
        await JS.InvokeVoidAsync("webcam.stop");
        Status = "Camera disconnected";
    }

    async Task SaveFace()
    {
        if (string.IsNullOrEmpty(CapturedImage))
        {
            Status = "No image captured";
            return;
        }

        try
        {
            var path = await FaceService.SaveFaceAsync(CapturedImage, selectedMemberId);
            Status = $"Saved: {path}";
        }
        catch (Exception ex)
        {
            Status = ex.Message;
        }
    }

    async Task ChangeBrightness(string value)
    {
        Brightness = int.Parse(value);
        await ApplyEdit();
    }

    async Task RotateImage(string value)
    {
        Rotation = int.Parse(value);
        await ApplyEdit();
    }

    async Task ZoomImage(string value)
    {
        ZoomLevel = double.Parse(value);
        await ApplyEdit();
    }

    async Task ApplyEdit()
    {
        if (string.IsNullOrEmpty(CapturedImage)) return;

        CapturedImage = await JS.InvokeAsync<string>(
            "webcam.applyEdit",
            Brightness,
            Rotation,
            ZoomLevel
        );
    }

    async Task Undo()
    {
        CapturedImage = await JS.InvokeAsync<string>("webcam.undo");
    }

    bool CameraConnected = false;

    async Task ToggleCamera()
    {
        try
        {
            if (!CameraConnected)
            {
                await JS.InvokeVoidAsync("webcam.start");

                CameraConnected = true;
                Status = "Camera connected";
            }
            else
            {
                await JS.InvokeVoidAsync("webcam.stop");

                CameraConnected = false;
                Status = "Camera disconnected";
            }
        }
        catch
        {
            CameraConnected = false;
            Status = "Failed to connect camera";
        }
    }

}

<style>

    .biometric-container {
        min-height: 87vh; /* ✅ instead of fixed height */
        display: flex;
        flex-direction: column;
    }

    /* HEADER */
    .header-bar {
        background: #355c9a;
        color: white;
        padding: 10px;
        border-radius: 5px;
        flex-shrink: 0;
    }

    /* ROW FIX */
    .row {
        flex: 1;
        margin-top: 10px;
    }

    /* PANELS */
    .control-panel,
    .preview-panel,
    .col-lg-6 {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    /* CAMERA SECTION */
    .camera-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 3; /* 🔥 FIXED RATIO */
        border: 2px solid #cbd5e1;
        border-radius: 6px;
        overflow: hidden;
        background: black;
    }

        /* VIDEO */
        .camera-wrapper video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* FACE GUIDE */
    .face-guide {
        position: absolute;
        top: 45%;
        left: 50%;
        width: 40%;
        height: 70%;
        transform: translate(-50%, -50%);
        border: 3px dashed #00ffcc;
        border-radius: 50%;
        pointer-events: none;
    }

    /* BUTTONS */
    .camera-buttons {
        margin-top: 10px;
        display: flex;
        gap: 8px;
        justify-content: center;
        flex-wrap: wrap;
        flex-shrink: 0;
    }

    /* PREVIEW */
    .preview-box {
        width: 100%;
        aspect-ratio: 4 / 3; /* keep camera aspect ratio */
        max-height: 400px; /* increased from 320px for bigger preview */
        margin: 0 auto 15px auto; /* spacing below preview */
        border: 2px solid #cbd5e1;
        border-radius: 6px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #f8fafc;
        overflow: hidden;
    }

        .preview-box img {
            width: 100%; /* make image fill the preview box */
            height: auto; /* maintain aspect ratio */
            object-fit: contain;
        }

    .preview-panel {
        align-items: center;
    }

    /* TEXT */
    .panel-title {
        font-weight: 600;
        color: #355c9a;
        margin-bottom: 10px;
        flex-shrink: 0;
    }

    .control-item {
        margin-bottom: 10px;
    }

    /* INSTRUCTIONS */
    .instructions {
        font-size: 12px;
        margin-top: 20px; /* pushed down a bit */
    }

    /* STATUS */
    .status-box {
        margin-top: 5px;
        flex-shrink: 0;
    }

    /* ICON */
    .camera-buttons i {
        margin-right: 6px;
    }

    /* 🔥 MOBILE FIX */
    @@media (max-width: 768px) {
        .row {
            flex-direction: column;
        }

        @@media (max-width: 768px) {

            .preview-box {
                max-height: 180px;
            }
        }



        .col-lg-6,
        .preview-panel {
            height: 50%;
        }

        .camera-buttons button {
            flex: 1 1 30%;
            font-size: 12px;
            padding: 6px;
        }

        input:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
    }
</style>