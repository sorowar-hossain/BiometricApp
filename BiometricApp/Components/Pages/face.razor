    //         CapturedImage = LiveImage;
    //         if (isAutoCropEnable)
    //         {
    //             Status = "Auto crop enabled";
    //         }
    //         else
    //         {
    //             Status = "Auto crop disabled";
    //         }
    //     }
    //     catch (Exception ex)
    //     {
    //         Status = ex.Message;
    //     }
    // }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _uiTimer = new System.Timers.Timer(100);

            _uiTimer.Elapsed += async (s, e) =>
            {
                if (CameraConnected)
                {
                    LiveImage =
                        FaceCaptureService.GetLiveBase64();

                    await InvokeAsync(StateHasChanged);
                }
            };

            _uiTimer.Start();
        }
    }

    void RotateLeft()
    {
        FaceCaptureService.RotateLeft();

        Status = "Rotated Left";
    }

    void RotateRight()
    {
        FaceCaptureService.RotateRight();

        Status = "Rotated Right";
    }

    void ZoomIn()
    {
        FaceCaptureService.ZoomIn();

        Status = "Zoom In";
    }

    void ZoomOut()
    {
        FaceCaptureService.ZoomOut();

        Status = "Zoom Out";
    }

    void EnableAutoCrop()
    {
        FaceCaptureService.SetAutoCrop(true);

        Status = "Auto Crop Enabled";
    }

    void DisableAutoCrop()
    {
        FaceCaptureService.SetAutoCrop(false);

        Status = "Auto Crop Disabled";
    }

    async Task ChangeResolution(ChangeEventArgs e)
    {
        try
        {
            if (e.Value == null)
                return;

            int resIndex =
                Convert.ToInt32(e.Value);

            FaceCaptureService
                .SetResolution(resIndex);

            Status =
                $"Resolution Changed";

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Status = ex.Message;
        }
    }

    public void Dispose()
    {
        _uiTimer?.Stop();

        _uiTimer?.Dispose();

        FaceCaptureService.StopCamera();
    }
}

<style>
    .biometric-container {
        padding: 20px;
    }

    .header-bar {
        background: #4868a8;
        color: white;
        padding: 12px;
        border-radius: 8px;
    }

    .live-camera-box,
    .preview-box {
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        height: 420px;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        background: #f8f8f8;
    }

    .camera-placeholder {
        color: gray;
        font-size: 18px;
    }

    .camera-buttons button {
        margin: 5px;
        min-width: 140px;
    }

    .status-box {
        font-size: 14px;
        color: #444;
    }

    .face_recog_second_column {
        border-top: 1px solid #ccc;
        position: relative;
        top: -4px;
    }
</style>