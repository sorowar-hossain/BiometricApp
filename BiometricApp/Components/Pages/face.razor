@page "/face-capture"
@inject UserSessionService SessionService

@using BiometricApp.Models
@using BiometricApp.Services

@inject FaceCaptureHcService FaceCaptureService
@inject LocalStorageService LocalStorageService

<div class="container-fluid biometric-container">

    <!-- HEADER -->
 @*    <div class="header-bar text-center">
        <h4>Biometric Enrollment System</h4>
    </div> *@

    <div class="row mt-3">

        <!-- LEFT PANEL -->
        <div class="col-lg-3 col-md-12 control-panel">

            @* <h6>Select Member</h6>

            <select class="form-control" @bind="selectedMemberId">
                <option value="">-- Select Member --</option>

                @foreach (var item in members)
                {
                    <option value="@item.PersonUniqueId">
                        @item.FullName
                    </option>
                }
            </select> *@

            <!-- CONTROLS -->
            <div class="mt-3">

                <div class="mt-3">
                    <button class="btn btn-success"
                            @onclick="EnableAutoCrop">
                        Enable Auto Crop
                    </button>

                    <button class="btn btn-danger"
                            @onclick="DisableAutoCrop">
                        Disable Auto Crop
                    </button>
                </div>

                <div class="mt-3">
                    <button class="btn btn-primary"
                            @onclick="RotateLeft">
                        Rotate Left
                    </button>

                    <button class="btn btn-primary"
                            @onclick="RotateRight">
                        Rotate Right
                    </button>
                </div>
                       

                <div class="mt-3">
                    <button class="btn btn-primary"
                            @onclick="ZoomIn">
                        Zoom In
                    </button>

                    <button class="btn btn-primary"
                            @onclick="ZoomOut">
                        Zoom Out
                    </button>
                </div>

                <div class="mt-3">
                    <button class="btn btn-primary">Portrait Orientation</button>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary">Landescape Orientation</button>
                </div>

                <div class="mt-3">
                    <select class="form-control"
                            @onchange="ChangeResolution">

                        <option value="">Select Resolution</option>

                        <option value="0">640×480</option>

                        <option value="1">800×600</option>

                        <option value="2">1280×720</option>

                        <option value="3">1920×1080</option>

                    </select>
                </div>
            </div>

            <button class="btn btn-secondary w-100 mt-3 save-btn"
                    @onclick="Retake">
                Undo
            </button>

            <div class="instructions mt-4">
                <h6>Capture Instructions</h6>

                <ul>
                    <li>Face centered inside frame</li>
                    <li>Good lighting required</li>
                    <li>No glasses or hats</li>
                    <li>Neutral expression</li>
                </ul>
            </div>

        </div>

        <!-- CENTER CAMERA -->
        <div class="col-lg-6 col-md-12">

            <h5 class="panel-title text-center">Live Camera</h5>

            <div class="live-camera-box">

                @if (CameraConnected &&
                                !string.IsNullOrEmpty(LiveImage))
                {
                    <img class="w-100 h-100 object-fit-contain"
                         src="@($"data:image/jpeg;base64,{LiveImage}")" />
                }
                else
                {
                    <div class="camera-placeholder">
                        Camera Not Started
                    </div>
                }

            </div>

            <div class="camera-buttons mt-3">

                <button class="btn btn-info save-btn"
                        @onclick="ToggleCamera">
                    @(CameraConnected ? "Close Camera" : "Start Camera")
                </button>

                <button class="btn btn-primary px-4 save-btn me-2"
                        @onclick="Capture"
                        disabled="@(!CameraConnected)">
                    <i class="bi bi-camera-fill"></i> Capture
                </button>


                <button class="btn btn-warning save-btn"
                        @onclick="Retake"
                        disabled="@string.IsNullOrEmpty(CapturedImage)">
                    <i class="bi bi-arrow-repeat"></i>Retake
                </button>

            </div>
            <div class="mt-3">
                <h5>Image Quality Score: 20%</h5>
            </div>
            <div class="row mt-3">
                <h4>Face Recognition</h4>
                <hr />
                <div class="col-lg-6 col-md-12">
                    <h6>Emotion: Neutral</h6>
                </div>
                <div class="col-lg-6 col-md-12">
                    <h6>Confidence: 70%</h6>
                </div>
            </div>
            <div class="row mt-3">
                <h4>Gender</h4>
                <hr />
                <div class="col-lg-6 col-md-12">
                    <h6>Male: 99%</h6>
                </div>
                <div class="col-lg-6 col-md-12">
                    <h6>Female: 0%</h6>
                </div>
            </div>
        </div>

        <!-- RIGHT PREVIEW -->
        <div class="col-lg-3 col-md-12 preview-panel">

            <h5 class="panel-title">Captured Face</h5>

            <div class="preview-box">

                @if (!string.IsNullOrEmpty(CapturedImage))
                {
                    <img class="w-100 h-100 object-fit-contain"
                         src="@($"data:image/jpeg;base64,{CapturedImage}")" />
                }
                else
                {
                    <div class="camera-placeholder">
                        No Captured Image
                    </div>
                }

            </div>



            <div class="d-flex justify-content-center mt-2">
                <div class="d-flex justify-content-center mt-2">
                    <button class="btn btn-success save-btn custom-save-btn"
                            @onclick="SaveFace"
                            disabled="@string.IsNullOrEmpty(CapturedImage)">
                        <i class="bi bi-check2-circle me-1"></i>Save Photo
                    </button>
                </div>
            </div>

            <div class="status-box mt-3">
                <h6>Status: @Status</h6>
            </div>
            <div class="row mt-3"></div>
            <div class="row mt-3"></div>
            <div class="row mt-3"></div>
            <div class="row mt-3"></div>
            <div class="row mt-3 face_recog_second_column">
                <div class="mt-3"></div>
                <div class="col-lg-6 col-md-12">
                    <h6>Happy: 10%</h6>
                </div>
                <div class="col-lg-6 col-md-12">
                    <h6>Angry: 0%</h6>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-lg-6 col-md-12">
                    <h6>Surprised: 5%</h6>
                </div>
                <div class="col-lg-6 col-md-12">
                    <h6>Sad: 3%</h6>
                </div>
            </div>
        </div>
    </div>

</div>

@code {

    private List<MemberDropdown> members = new();

    private string selectedMemberId;

    private bool CameraConnected;

    private string LiveImage;
    private byte[] faceImageBytes;

    private string CapturedImage;

    private string Status = "Idle";
    string path = "";

    private System.Timers.Timer _uiTimer;

    protected override async Task OnInitializedAsync()
    {
        selectedMemberId = SessionService.User.PersonUniqueId;
        path = AppSettings.BaseFolder;

        //members = await LocalStorageService.GetMembersForDropdownAsync();
    }

    async Task ToggleCamera()
    {
        try
        {
            if (!CameraConnected)
            {
                FaceCaptureService.StartCamera();

                CameraConnected = true;

                Status = "Camera Started";
            }
            else
            {
                FaceCaptureService.StopCamera();

                CameraConnected = false;

                LiveImage = null;

                CapturedImage = null;

                Status = "Camera Closed";
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Status = ex.Message;
        }
    }

    // async Task Capture()
    // {
    //     try
    //     {
    //         if (string.IsNullOrWhiteSpace(selectedMemberId))
    //         {
    //             Status = "Select member first";
    //             return;
    //         }

    //         CapturedImage = LiveImage;

    //         Status = "Face Captured";

    //         await InvokeAsync(StateHasChanged);
    //     }
    //     catch (Exception ex)
    //     {
    //         Status = ex.Message;
    //     }
    // }

    async Task Capture()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(selectedMemberId))
            {
                Status = "Member not found..!";
                return;
            }

            CapturedImage =
                FaceCaptureService.CaptureFace();
            Status = "Face Captured";

           

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Status = ex.Message;
        }
    }

    void Retake()
    {
        CapturedImage = null;

        Status = "Retake Image";
    }

    async Task SaveFace()
    {
        try
        {
            if (string.IsNullOrEmpty(CapturedImage))
                return;
            string folder = Path.Combine(path, selectedMemberId);

            await FaceCaptureService.SaveFace(CapturedImage, folder);

            Status = "Photo Saved Successfully";
        }
        catch (Exception ex)
        {
            Status = ex.Message;
        }
    }

    // async Task AutoCropEnabled()
    // {
    //     try
    //     {
    //         bool isAutoCropEnable = true;
    //         if (string.IsNullOrEmpty(CapturedImage))
    //             return;

    //         FaceCaptureService.AutoCropService(
    //             isAutoCropEnable);

    //         CapturedImage = LiveImage;
    //         if (isAutoCropEnable)
    //         {
    //             Status = "Auto crop enabled";
    //         }
    //         else
    //         {
    //             Status = "Auto crop disabled";
    //         }
    //     }
    //     catch (Exception ex)
    //     {
    //         Status = ex.Message;
    //     }
    // }

    // async Task AutoCropDisabled()
    // {
    //     try
    //     {
    //         bool isAutoCropEnable = false;
    //         if (string.IsNullOrEmpty(CapturedImage))
    //             return;

    //         FaceCaptureService.AutoCropService(
    //             isAutoCropEnable);

    //         CapturedImage = LiveImage;
    //         if (isAutoCropEnable)
    //         {
    //             Status = "Auto crop enabled";
    //         }
    //         else
    //         {
    //             Status = "Auto crop disabled";
    //         }
    //     }
    //     catch (Exception ex)
    //     {
    //         Status = ex.Message;
    //     }
    // }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _uiTimer = new System.Timers.Timer(100);

            _uiTimer.Elapsed += async (s, e) =>
            {
                if (CameraConnected)
                {
                    LiveImage =
                        FaceCaptureService.GetLiveBase64();

                    await InvokeAsync(StateHasChanged);
                }
            };

            _uiTimer.Start();
        }
    }

    void RotateLeft()
    {
        FaceCaptureService.RotateLeft();

        Status = "Rotated Left";
    }

    void RotateRight()
    {
        FaceCaptureService.RotateRight();

        Status = "Rotated Right";
    }

    void ZoomIn()
    {
        FaceCaptureService.ZoomIn();

        Status = "Zoom In";
    }

    void ZoomOut()
    {
        FaceCaptureService.ZoomOut();

        Status = "Zoom Out";
    }

    void EnableAutoCrop()
    {
        FaceCaptureService.SetAutoCrop(true);

        Status = "Auto Crop Enabled";
    }

    void DisableAutoCrop()
    {
        FaceCaptureService.SetAutoCrop(false);

        Status = "Auto Crop Disabled";
    }

    async Task ChangeResolution(ChangeEventArgs e)
    {
        try
        {
            if (e.Value == null)
                return;

            int resIndex =
                Convert.ToInt32(e.Value);

            FaceCaptureService
                .SetResolution(resIndex);

            Status =
                $"Resolution Changed";

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Status = ex.Message;
        }
    }

    public void Dispose()
    {
        _uiTimer?.Stop();

        _uiTimer?.Dispose();

        FaceCaptureService.StopCamera();
    }
}

<style>
    .biometric-container {
        padding: 20px;
    }

    .header-bar {
        background: #4868a8;
        color: white;
        padding: 12px;
        border-radius: 8px;
    }

    /* =========================
       LIVE CAMERA BOX
       ========================= */
    .live-camera-box {
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        height: 300px;
        width: 100%;
        max-width: 600px;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        background: #f8f8f8;
    }

    /* =========================
       PREVIEW BOX (CAPTURED FACE)
       ========================= */
    .preview-box {
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        background: #f8f8f8;
        width: 100%;
        height: 100%;
        min-width: 300px;
        min-height: 300px;
    }

        /* IMAGE FIT */
        .live-camera-box img,
        .preview-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    /* PLACEHOLDER */
    .camera-placeholder {
        color: gray;
        font-size: 18px;
    }

    /* BUTTONS */
    .camera-buttons button {
        margin: 5px;
        min-width: 140px;
    }

    /* STATUS */
    .status-box {
        font-size: 14px;
        color: #444;
    }

    /* FACE RECOGNITION LINE */
    .face_recog_second_column {
        border-top: 1px solid #ccc;
        position: relative;
        top: -4px;
    }

    /* =========================
       TABLET
       ========================= */
    @@media (max-width: 992px) {
        .control-panel, .preview-panel

    {
        margin-top: 20px;
    }

    .live-camera-box {
        max-width: 100%;
        height: 300px;
    }

    .preview-box {
        min-width: 300px;
        min-height: 300px;
    }

    }

    /* =========================
       MOBILE
       ========================= */
    @@media (max-width: 768px) {
        .biometric-container

    {
        padding: 15px;
    }

    .camera-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

        .camera-buttons button {
            width: 100%;
            margin: 0;
        }

    .save-btn {
        width: 100% !important;
    }

    .face_recog_second_column {
        top: 0;
    }

    }

    /* =========================
       SMALL MOBILE
       ========================= */
    @@media (max-width: 576px) {
        .biometric-container

    {
        padding: 10px;
    }

    .live-camera-box {
        height: 220px;
    }

    .preview-box {
        min-width: 300px;
        min-height: 300px;
    }

    .camera-placeholder {
        font-size: 14px;
        text-align: center;
    }

    }

    .custom-save-btn {
        width: 220px;
    }

    @@media (max-width: 768px) {
        .custom-save-btn

    {
        width: 100%;
    }

    }
</style>