            if (string.IsNullOrWhiteSpace(selectedMemberId))
            {
                Status = "Select member first";
                return;
            }

            CapturedImage =
                FaceCaptureService.CaptureFace();

            Status = "Face Captured";

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Status = ex.Message;
        }
    }

    void Retake()
    {
        CapturedImage = null;

        Status = "Retake Image";
    }

    async Task SaveFace()
    {
