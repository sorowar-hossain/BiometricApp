@page "/"
@layout LoginLayout

@using System.ComponentModel.DataAnnotations
@using BiometricApp.Components.Layout
@using BiometricApp.Models
@using BiometricApp.Services
@inject NavigationManager Navigation
@inject ApiService ApiService
@inject UserService UserService
@inject LocalUserService LocalUserService

<div class="login-container">
    <h2>Login</h2>
    <p class="subtext">@loginMessage</p>
    
        
    <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <InputText @bind-Value="loginModel.Username" placeholder="Username" class="form-control"  />
            <ValidationMessage For="@(() => loginModel.Username)" />
        </div>

        <div class="form-group">
            <InputText @bind-Value="loginModel.Password" type="password" placeholder="Password" class="form-control" />
            <ValidationMessage For="@(() => loginModel.Password)" />
        </div>
        <!-- Instruction points -->
        <div class="login-instructions">
            <ul>
                <li>Enter your correct username.</li>
                <li>Enter your password carefully; it is case-sensitive.</li>
                <li>Ensure your Caps Lock is off.</li>
                <li>Click "Login" to access your account.</li>
            </ul>
        </div>
        @{
            if (!isExpired)
            {
                <button type="submit">Login</button>
            }
        }
    </EditForm>

  @*   <a href="#" class="forgot-password">Forgot Password?</a> *@
</div>
<style>
    .login-instructions {
        text-align: left; /* align points to the left */
        margin-bottom: 20px; /* space before button */
        font-size: 14px;
        color: #555;
    }

        .login-instructions ul {
            padding-left: 20px; /* indent bullets */
        }

        .login-instructions li {
            margin-bottom: 5px; /* space between points */
        }
    body {
        background: #f0f2f5;
        font-family: Arial, sans-serif;
    }

    .login-container h2 {
        margin-bottom: 10px; /* less space below the h2 */
        
    }

    .subtext {
        margin-top: 0; /* remove extra space above */
        margin-bottom: 20px; /* add a little space below */
        font-size: 14px; /* smaller than h2 */
        font-weight: bold; /* optional color */
       
    }

    .login-container {
        max-width: 400px;
        margin: 60px auto;
        padding: 40px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        text-align: center;
    }

    .logo {
        width: 80px;
        margin-bottom: 20px;
    }

    h2 {
        margin-bottom: 30px;
        color: #333;
    }

    .form-group {
        margin-bottom: 20px;
        text-align: left;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        font-size: 16px;
        border-radius: 8px;
        border: 1px solid #ccc;
        outline: none;
        transition: 0.3s;
    }

        .form-control:focus {
            border-color: #007bff;
            box-shadow: 0 0 5px rgba(0,123,255,0.3);
        }

    button {
        width: 100%;
        padding: 12px;
        background: #007bff;
        border: none;
        border-radius: 8px;
        color: #fff;
        font-size: 16px;
        cursor: pointer;
        transition: 0.3s;
    }

        button:hover {
            background: #0056b3;
        }

    .forgot-password {
        display: block;
        margin-top: 15px;
        font-size: 14px;
        color: #555;
        text-decoration: none;
    }

        .forgot-password:hover {
            text-decoration: underline;
        }
</style>

@code {
    private LoginModel loginModel = new();
    private string loginMessage = "We're so excited to see you login";
    private UserLoginResponse res = new();
    private bool isExpired;
    private readonly string _timeFile = Path.Combine(@"C:\Biometric_APP_Master\win10-x64", "system_time.dat");
    private readonly DateTime startDate = new(2026, 6, 19);
    private readonly DateTime expiredDate = new(2026, 6, 30);

    private System.Timers.Timer? _timer;

    protected override void OnInitialized()
    {
        CheckExpiry();

        _timer = new System.Timers.Timer(10000);
        _timer.AutoReset = true;
        _timer.Elapsed += (_, _) => InvokeAsync(CheckExpiry);

        _timer.Start();
    }

    private void CheckExpiry()
    {
        var now = DateTime.Now;

        var times = ReadLastTwoTimes();

        // First run
        if (times == null || times.Count == 0)
        {
            SaveCurrentTime(now);
        }
        else
        {
            // Get last two records
            var last = times.Last();
            var secondLast = times.Count > 1 ? times[^2] : last;

            // 🔥 TIME JUMP DETECTION
            var diff = last - secondLast;
            if (last.Date != secondLast.Date)
            {
                if (diff.TotalMinutes > 1500 || diff.TotalMinutes < 0) // too fast jump forward
                {
                    isExpired = true;
                    loginMessage = "A problem has been identified with the device. Please contact the development team for further assistance";
                }
            }
            else
            {
                SaveCurrentTime(now);
            }
            // Expiry check
            if (now.Date < startDate.Date || now.Date > expiredDate.Date)
            {
                isExpired = true;
                loginMessage = "A problem has been identified with the device. Please contact the development team for further assistance";
            }
        }
        StateHasChanged();
    }
    private void SaveCurrentTime(DateTime now)
    {
        try
        {
            File.AppendAllText(_timeFile, now.ToString("O") + Environment.NewLine); // ISO format
        }
        catch
        {
            // optional: log error
        }
    }
    private List<DateTime> ReadLastTwoTimes()
    {
        if (!File.Exists(_timeFile))
            return new List<DateTime>();

        var lines = File.ReadAllLines(_timeFile);

        return lines
            .Where(x => DateTime.TryParse(x, out _))
            .Select(DateTime.Parse)
            .ToList();
    }
    public void Dispose()
    {
        if (_timer != null)
        {
            _timer.Stop();
            _timer.Dispose();
            _timer = null;
        }
    }
    private async Task HandleLogin()
    {
        // Clear any previous message
        loginMessage = "";

        try
        {
             res = await LocalUserService.UserValidation(loginModel);
            // var res = await ApiService.LoginAsync(loginModel.Username, loginModel.Password);

            if (res.Success)
            {
                UserService.CurrentUser = res; // Store user globally
                // Login successful: reset form and navigate
                loginModel = new LoginModel();
                loginMessage = "";
                StateHasChanged(); // refresh UI before navigation
                Navigation.NavigateTo("/biometric-enrollment");
            }
            else
            {
                // Login failed: show message
                loginMessage = "Invalid username or password. Please try again.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // Handle unexpected errors
            loginMessage = $"An error occurred: {ex.Message}";
            StateHasChanged();
        }
    }

}