@page "/iris-capture"
@using BiometricApp.Models
@using BiometricApp.Services
@inject BiometricApp.Services.IrisService IrisService
@inject LocalStorageService LocalStorageService

<div class="iris-wrapper">

    <div class="header-bar">
        Data Capturing System
    </div>

    <div class="content-area text-center">

        <h5 class="section-title">Iris Capture</h5>
        <p class="text-muted small">
            Stand or sit still in front of the iris scanner
        </p>

        <div class="row justify-content-center mt-4">
            <div class="col-md-3 text-center">
                <label>Select Member</label>

                <select class="form-control" @bind="selectedMemberId">
                    <option value="">-- Select Member --</option>

                    @foreach (var item in members)
                    {
                        <option value="@item.PersonUniqueId">
                            @item.FullName
                        </option>
                    }
                </select>
            </div>

            <!-- Left Preview Small -->
            <div class="col-md-2 text-center">
                <img src="@LeftPreviewImage" class="thumb-img" />
            </div>

            <!-- Left Iris Large -->
            <div class="col-md-3 text-center">
                <p class="fw-semibold">Left Iris</p>
                <img src="@LeftIrisImage" class="iris-img" />
                <p class="capture-status text-success">@LeftCaptureStatus</p>
            </div>

            <!-- Right Iris Large -->
            <div class="col-md-3 text-center">
                <p class="fw-semibold">Right Iris</p>
                <img src="@RightIrisImage" class="iris-img" />
                <p class="capture-status text-success">@RightCaptureStatus</p>
            </div>

            <!-- Right Preview Small -->
            <div class="col-md-2 text-center">
                <img src="@RightPreviewImage" class="thumb-img" />
            </div>

        </div>

        <!-- Buttons -->
        <div class="mt-4">
            <button class="btn btn-outline-primary me-2" @onclick="Retake">Retake</button>
            <button class="btn btn-dark me-2" @onclick="CaptureIris">
                <i class="bi bi-camera-fill"></i> Capture
            </button>
            <button class="btn btn-primary" @onclick="SaveIrisImagesToServer">Save</button>
        </div>

        <div class="d-flex justify-content-between mt-5 px-5">
           @*  <button class="btn btn-light border">Back</button>
            <button class="btn btn-primary px-4">Next</button> *@
        </div>

    </div>
</div>

@code {
    // Image sources as Base64 strings
    private string LeftIrisImage = "images/Iris-Left.jpg";
    private string RightIrisImage = "images/Iris-Right.jpg";
    private string LeftPreviewImage = "images/Iris-Left.jpg";
    private string RightPreviewImage = "images/Iris-Right.jpg";

    private string LeftCaptureStatus = "";
    private string RightCaptureStatus = "";

    private byte[] leftImageBytes;
    private byte[] rightImageBytes;

    private string path = @"C:\Biometric_Iris";
    private List<MemberDropdown> members = new();
    private string selectedMemberId;

    protected override async Task OnInitializedAsync()
    {
        members = await LocalStorageService.GetMembersForDropdownAsync();
    }
    private void SelectMember(MemberDropdown item)
    {
        selectedMemberId = item.PersonUniqueId;
    }

    private async Task CaptureIris()
    {
        if (string.IsNullOrWhiteSpace(selectedMemberId))
        {
            return;
        }

        // Attach device first (if not already attached)
        IrisService.AttachDevice();

        // Capture images
        var result = IrisService.Capture();

        leftImageBytes = result.leftImage;
        rightImageBytes = result.rightImage;

     

        // Convert byte array to Base64 string
        string leftBase64 = Convert.ToBase64String(leftImageBytes);
        string rightBase64 = Convert.ToBase64String(rightImageBytes);

        // Build data URL
        LeftIrisImage = $"data:image/png;base64,{leftBase64}";
        RightIrisImage = $"data:image/png;base64,{rightBase64}";

        LeftPreviewImage = LeftIrisImage;
        RightPreviewImage = RightIrisImage;

        LeftCaptureStatus = "Capture completed";
        RightCaptureStatus = "Capture completed";
        SaveIrisImages();

        string leftPath = Path.Combine(path, "left_iris.png");
        string rightPath = Path.Combine(path, "right_iris.png");

        if (File.Exists(leftPath))
        {
            byte[] leftBytes = File.ReadAllBytes(leftPath);
            LeftIrisImage = $"data:image/png;base64,{Convert.ToBase64String(leftBytes)}";
            LeftPreviewImage = $"data:image/png;base64,{Convert.ToBase64String(leftBytes)}";
        }

        if (File.Exists(rightPath))
        {
            byte[] rightBytes = File.ReadAllBytes(rightPath);
            RightIrisImage = $"data:image/png;base64,{Convert.ToBase64String(rightBytes)}";
            RightPreviewImage = $"data:image/png;base64,{Convert.ToBase64String(rightBytes)}";
        }

        StateHasChanged();
    }

    private void SaveIrisImages()
    {
        if (leftImageBytes != null && rightImageBytes != null)
        {
            IrisService.SaveImages(leftImageBytes, rightImageBytes, path);
        }
    }

    private void SaveIrisImagesToServer()
    {
        if (leftImageBytes != null && rightImageBytes != null)
        {
            // save to server later
        }
    }

    

    private void Retake()
    {
        // Reset UI to placeholder
        LeftIrisImage = "images/Iris-Left.jpg";
        RightIrisImage = "images/Iris-Right.jpg";
        LeftPreviewImage = "images/Iris-Left.jpg";
        RightPreviewImage = "images/Iris-Right.jpg";
        LeftCaptureStatus = "";
        RightCaptureStatus = "";
    }
}

<style>
    .iris-wrapper {
        background-color: #f5f6f8;
        min-height: 100vh;
    }

    .header-bar {
        background-color: #2f5fa4;
        color: white;
        padding: 12px;
        font-weight: 600;
        text-align: center;
        font-size: 18px;
    }

    .content-area {
        background: #ffffff;
        margin: 40px auto;
        padding: 40px;
        max-width: 1100px;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .section-title {
        color: #2f5fa4;
    }

    .iris-img {
        width: 100%;
        max-width: 220px;
        height: auto;
        border: 3px solid #2f5fa4;
        border-radius: 4px;
    }

    .thumb-img {
        width: 80px;
        border: 2px solid #2f5fa4;
        border-radius: 4px;
    }

    .capture-status {
        font-size: 13px;
        margin-top: 8px;
    }
</style>

