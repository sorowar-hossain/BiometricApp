@page "/iris-capture"
@using BiometricApp.Models
@using BiometricApp.Services
@inject BiometricApp.Services.IrisService IrisService
@inject LocalStorageService LocalStorageService
@inject NavigationManager Navigation
@inject UserSessionService SessionService

<!-- IRIS SECTION -->
<div class="iris-container row">

    <!-- LEFT IRIS -->
    <div class="col-md-6 col-12 mb-3">
        <div class="iris-card">

            <div class="iris-title">Left Iris</div>

            <div class="iris-box">
                @if (!string.IsNullOrEmpty(LeftIrisImage))
                {
                    <img src="@LeftIrisImage" class="iris-img" />
                }
            </div>

            <div class="status-text">@LeftCaptureStatus</div>

        </div>

        <!-- BUTTONS -->
        <div class="button-bar mt-4" style="margin-left:100px;">

            <div class="btn-left">
                <button class="btn btn-success px-4 save-btn"
                        @onclick="CaptureIris"
                        disabled="@isProcessing">
                    <i class="bi bi-camera-fill"></i> Capture
                </button>

                <button class="btn btn-warning px-4 save-btn"
                        @onclick="Retake"
                        disabled="@isProcessing">
                    <i class="bi bi-arrow-repeat"></i> Retake
                </button>
                <button class="btn btn-success px-4 save-btn save-btn"
                        disabled="@isProcessing">
                    Save
                </button>
            </div>



        </div>
    </div>

    <!-- RIGHT IRIS -->
    <div class="col-md-6 col-12 mb-3">
        <div class="iris-card">

            <div class="iris-title">Right Iris</div>

            <div class="iris-box">
                @if (!string.IsNullOrEmpty(RightIrisImage))
                {
                    <img src="@RightIrisImage" class="iris-img" />
                }
            </div>

            <div class="status-text">@RightCaptureStatus</div>

        </div>
    </div>

   
</div>



@code {
    // Image sources as Base64 strings
    private string message = "";
    private string LeftIrisImage = "";
    private string RightIrisImage = "";
    private string LeftPreviewImage = "";
    private string RightPreviewImage = "";

    private string LeftCaptureStatus = "";
    private string RightCaptureStatus = "";

    private byte[] leftImageBytes;
    private byte[] rightImageBytes;

    private string path = AppSettings.BaseFolder;
    private List<MemberDropdown> members = new();
    private string selectedMemberId;
    bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        message = "";
        //members = await LocalStorageService.GetMembersForDropdownAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        string? memberId = query["id"];

        if (!string.IsNullOrWhiteSpace(memberId))
        {
            selectedMemberId = memberId;
        }
    }

    private void SelectMember(MemberDropdown item)
    {
        selectedMemberId = item.PersonUniqueId;
    }

    private async Task CaptureIris()
    {
        selectedMemberId = SessionService.User.PersonUniqueId;
        if (string.IsNullOrWhiteSpace(selectedMemberId))
        {
            return;
        }
      
        path = Path.Combine(path, selectedMemberId);

        // Attach device first (if not already attached)
        IrisService.AttachDevice();

        // Capture images
        var result = IrisService.Capture();

        leftImageBytes = result.leftImage;
        rightImageBytes = result.rightImage;



        // Convert byte array to Base64 string
        string leftBase64 = Convert.ToBase64String(leftImageBytes);
        string rightBase64 = Convert.ToBase64String(rightImageBytes);

        // Build data URL
        LeftIrisImage = $"data:image/png;base64,{leftBase64}";
        RightIrisImage = $"data:image/png;base64,{rightBase64}";

        LeftPreviewImage = LeftIrisImage;
        RightPreviewImage = RightIrisImage;

        LeftCaptureStatus = "Capture completed";
        RightCaptureStatus = "Capture completed";
        SaveIrisImages();

        string leftPath = Path.Combine(path, "left_iris.png");
        string rightPath = Path.Combine(path, "right_iris.png");

        if (File.Exists(leftPath))
        {
            byte[] leftBytes = File.ReadAllBytes(leftPath);
            LeftIrisImage = $"data:image/png;base64,{Convert.ToBase64String(leftBytes)}";
            LeftPreviewImage = $"data:image/png;base64,{Convert.ToBase64String(leftBytes)}";
        }

        if (File.Exists(rightPath))
        {
            byte[] rightBytes = File.ReadAllBytes(rightPath);
            RightIrisImage = $"data:image/png;base64,{Convert.ToBase64String(rightBytes)}";
            RightPreviewImage = $"data:image/png;base64,{Convert.ToBase64String(rightBytes)}";
        }

        StateHasChanged();
    }

    private void GoNext()
    {
        if (string.IsNullOrWhiteSpace(selectedMemberId))
            return;

        Navigation.NavigateTo($"/signature?id={selectedMemberId}");
    }

    private void SaveIrisImages()
    {
        if (leftImageBytes != null && rightImageBytes != null)
        {
            IrisService.SaveImages(leftImageBytes, rightImageBytes, path);
            message = "Iris saved successfully to " + path;
        }
    }

    private void SaveIrisImagesToServer()
    {
        if (leftImageBytes != null && rightImageBytes != null)
        {
            // save to server later
        }
    }



    private void Retake()
    {
        // Reset UI to placeholder
        LeftIrisImage = "";
        RightIrisImage = "";
        LeftPreviewImage = "";
        RightPreviewImage = "";
        LeftCaptureStatus = "";
        RightCaptureStatus = "";
        message = "";
        path = AppSettings.BaseFolder;
    }
}

<style>
    /* WRAPPER */
    .iris-wrapper {
        background: #eef2f6;
        min-height: 100vh;
    }

    /* MAIN CONTAINER */
    .content-area {
        width: 90%;
        margin: 20px auto;
        background: #ffffff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    }

    /* CARD */
    .iris-card {
        text-align: center;
    }

    /* TITLE */
    .iris-title {
        font-weight: 600;
        margin-bottom: 12px;
        color: #333;
        font-size:18px;
    }

    /* BOX */
    .iris-box {
        width: 100%;
        max-width: 480px;
        height: 240px;
        border: 2px solid #1f4b99;
        border-radius: 12px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin: 0 auto;
    }

    /* IMAGE */
    .iris-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* STATUS */
    .status-text {
        font-size: 13px;
        margin-top: 8px;
        color: #28a745;
        font-weight: 500;
    }

    /* BUTTON BAR (unchanged but improved spacing) */
    .button-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 30px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .btn-left {
        display: flex;
        gap: 10px;
    }

    .btn-right {
        margin-left: auto;
    }

    /* RESPONSIVE */
    @@media (max-width: 768px) {
        .content-area

    {
        width: 95%;
        padding: 20px;
    }

    .button-bar {
        flex-direction: column;
        align-items: stretch;
    }

    .btn-left {
        justify-content: center;
    }

    .btn-right {
        margin-left: 0;
        display: flex;
        justify-content: center;
    }

    .iris-box {
        height: 190px;
        max-width: 100%;
    }

    }
</style>


