@page "/detail-review"
@using BiometricApp.Models
@using BiometricApp.Services
@inject LocalStorageService LocalStorageService
@inject NavigationManager Navigation

<div class="container main-container">
    <div class="card shadow-sm">

        <!-- HEADER -->
        <div class="card-header text-center header-title">
            Data Capturing System
        </div>

        <div class="card-body">

            <h5 class="text-primary fw-bold">Detail Review</h5>
            <small class="text-muted">Carefully check all your personal information shown on the screen</small>
            <!-- Member Selection -->
            <div class="member-select">
                <label>Select Member</label>
                <select class="form-control" @bind="selectedMemberId">
                    <option value="">-- Select Member --</option>
                    @foreach (var item in members)
                    {
                        <option value="@item.PersonUniqueId">@item.FullName</option>
                    }
                </select>
            </div>

            <div class="row mt-4">

                <!-- ================= LEFT PANEL (BIOMETRICS) ================= -->
                <div class="col-md-6">
                    <div class="section-box">

                        <h6 class="section-title">Biometrics</h6>

                        <!-- FACE -->
                        <div class="mb-3 text-center">
                            <label class="biometric-label d-block text-start">Face</label>
                            @for (int i = 14; i < 15; i++)
                            {
                                <div class="photo-wrapper">
                                    @if (!string.IsNullOrEmpty(Fingerprints[i]))
                                    {
                                        <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="photo-box" />
                                    }

                                </div>

                            }

                        </div>

                        <!-- IRIS -->
                        <div class="mb-3">
                            <label class="biometric-label">Iris</label>
                            <div class="iris-container">
                                @for (int i = 10; i < 12; i++)
                                {
                                    var label = (i == 10) ? "Left Iris" : "Right Iris";
                                    <div class="iris-item">
                                        <p class="iris-label">@label</p>

                                        <div class="iris-box">
                                            @if (!string.IsNullOrEmpty(Fingerprints[i]))
                                            {
                                                <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="iris-img" />
                                            }
                                        </div>
                                    </div>
                                }


                            </div>
                        </div>

                        <!-- FINGERPRINTS -->
                        <div class="mb-3">
                            <label class="biometric-label">Fingerprints</label>

                            <!-- Hands Layout -->
                            <div class="hands">
                                <!-- LEFT HAND -->
                                <div class="hand-container">
                                    <div class="hand-title">Left Hand</div>

                                    <div class="slots">
                                        @for (int i = 0; i < 4; i++)
                                        {
                                            <div class="slot @(GetSlotClass(i))">

                                                <!-- Label -->
                                                <div class="finger-label">@GetFingerLabel(i)</div>

                                                <!-- Image -->
                                                @if (!string.IsNullOrEmpty(Fingerprints[i]))
                                                {
                                                    <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="finger-img" />
                                                }

                                            </div>
                                        }
                                    </div>
                                </div>

                            </div>

                            <div class="hands">


                                <!-- RIGHT HAND -->
                                <div class="hand-container">
                                    <div class="hand-title">Right Hand</div>
                                    <div class="slots">
                                        @for (int i = 6; i < 10; i++)
                                        {
                                            <div class="slot @(GetSlotClass(i))">
                                                <div class="finger-label">@GetFingerLabel(i)</div>
                                                @if (!string.IsNullOrEmpty(Fingerprints[i]))
                                                {
                                                    <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="finger-img" />
                                                }
                                            </div>
                                        }

                                    </div>

                                </div>
                            </div>

                            <!-- THUMBS -->
                            <div class="hand-container">
                                <div class="hand-title">Thumbs</div>
                                <div class="slots">
                                    <!-- LEFT THUMB -->
                                    <div class="slot @(GetSlotClass(4))">
                                        <div class="finger-label">@GetFingerLabel(4)</div>

                                        @if (!string.IsNullOrEmpty(Fingerprints[4]))
                                        {
                                            <img src="@($"data:image/bmp;base64,{Fingerprints[4]}")" class="finger-img" />
                                        }
                                    </div>

                                    <!-- RIGHT THUMB -->
                                    <div class="slot @(GetSlotClass(5))">
                                        <div class="finger-label">@GetFingerLabel(5)</div>

                                        @if (!string.IsNullOrEmpty(Fingerprints[5]))
                                        {
                                            <img src="@($"data:image/bmp;base64,{Fingerprints[5]}")" class="finger-img" />
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- SIGNATURES -->
                        <div class="mb-3">
                            <label class="biometric-label">Signatures</label>
                            <div class="signature-container">
                                @for (int i = 12; i < 14; i++)
                                {

                                    <div class="signature-box">
                                        <small>Signature @(i - 11)</small>
                                        @if (!string.IsNullOrEmpty(Fingerprints[i]))
                                        {
                                            <img src="@($"data:image/bmp;base64,{Fingerprints[i]}")" class="signature-img" />
                                        }
                                    </div>

                                }

                            </div>
                        </div>

                    </div>
                </div>

                <!-- ================= RIGHT PANEL (PERSONAL INFO) ================= -->
                <div class="col-md-6">
                    <div class="section-box">

                        <h6 class="section-title">Personal Information</h6>

                        <div class="info-row">
                            <label>Full Name</label>
                            <input class="form-control" value="@Model.FirstName @Model.LastName" readonly />
                        </div>
                        <div class="info-row">
                            <label>Father Name</label>
                            <input class="form-control" value="@Model.FatherName" readonly />
                        </div>
                        <div class="info-row">
                            <label>Mother Name</label>
                            <input class="form-control" value="@Model.MotherName" readonly />
                        </div>

                        <div class="info-row">
                            <label>Date of Birth</label>
                            <input class="form-control"
                                   value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))"
                                   readonly />
                        </div>

                        <div class="info-row">
                            <label>Date of Expiry</label>
                            <input class="form-control"
                                   value="@(Model.ExpiryDate?.ToString("yyyy-MM-dd"))"
                                   readonly />
                        </div>

                        <div class="info-row">
                            <label>Gender</label>
                            <input class="form-control" value="@Model.Gender" readonly />
                        </div>

                        <div class="info-row">
                            <label>Marital Status</label>
                            <input class="form-control" value="@Model.MaritalStatus" readonly />
                        </div>

                        <div class="info-row">
                            <label>Address</label>
                            <textarea class="form-control" rows="3" readonly>@Model.Address</textarea>
                        </div>

                        <div class="info-row d-flex justify-content-end mt-3">
                            <button class="btn btn-primary px-4" @onclick="UpdateInfo">Update</button>
                        </div>

                    </div>
                </div>




            </div>

            <!-- FOOTER -->
            <div class="d-flex justify-content-between mt-4">
                @*    <button class="btn btn-secondary px-4">Back</button>
                <button class="btn btn-primary px-4">Done</button> *@
            </div>

        </div>
    </div>
</div>

<style>
    /* MAIN CONTAINER */
    .main-container {
        background: #f4f6f9;
        padding: 20px;
    }

    .iris-box {
        width: 220px;
        height: 120px;
        border: 2px solid #2f5fa4;
        border-radius: 6px;
        background: #f8f9fa;
        overflow: hidden;
        padding: 4px; /* 👈 controls inner space */
    }

    .iris-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .iris-item {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .iris-label {
        margin-bottom: 6px;
        font-weight: 600;
        font-size: 13px;
    }
    /* HEADER */
    .header-title {
        background: linear-gradient(135deg, #2f5ea8, #4a7bd0);
        color: white;
        font-weight: 600;
        font-size: 18px;
    }

    /* MEMBER SELECT */
    .member-select {
        width: 250px;
    }

        .member-select .form-control {
            width: 100%;
        }

    .top-row {
        display: flex;
        align-items: flex-start;
        gap: 30px;
    }

    /* SECTION BOX */
    .section-box {
        border: 1px solid #e0e0e0;
        padding: 15px;
        background: #ffffff;
        border-radius: 6px;
        margin-bottom: 15px;
    }

    .section-title,
    .biometric-label {
        font-weight: 600;
        margin-bottom: 10px;
        color: #2f5ea8;
    }

    /* HAND LAYOUT */
    .hands {
        display: flex;
        justify-content: center;
        gap: 50px;
        margin-bottom: 15px;
    }

    .hand-container {
        text-align: center;
    }

    /* HAND TITLE */
    .hand-title {
        display: inline-block;
        background: #3b63a3;
        color: white;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 14px;
        margin-bottom: 10px;
    }

    /* FINGER SLOTS */
    .slots {
        display: flex;
        justify-content: center;
        gap: 12px;
    }

    /* SINGLE SLOT */
    .slot {
        position: relative;
        width: 120px;
        height: 120px;
        border: 2px solid #3b63a3;
        border-radius: 8px;
        background-color: #f4f6f9;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ACTIVE SLOT */
    .active-finger {
        background-color: #4CAF50;
        border-color: #4CAF50;
    }

    /* COMPLETED SLOT */
    .slot.completed {
        background: #d4edda;
        border-color: #28a745;
    }

    /* LABEL INSIDE BOX */
    .finger-label {
        position: absolute;
        top: 4px;
        left: 6px;
        font-size: 11px;
        font-weight: bold;
        background: rgba(255, 255, 255, 0.85);
        padding: 1px 4px;
        border-radius: 4px;
        z-index: 2;
    }

    /* FINGERPRINT IMAGE */
    .finger-img {
        width: 115%;
        height: 100%;
        object-fit: contain;
    }

    /* THUMB SECTION */
    .thumb-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 15px;
    }

        .thumb-section .slots {
            gap: 20px;
        }

    /* PHOTO */
    .photo-wrapper {
        width: 100%;
        height: 180px;
        border: 1px solid #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .photo-box {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* IRIS */
    .iris-container {
        display: flex;
        gap: 10px;
        justify-content: center;
    }


    /* SIGNATURE */
    .signature-container {
        display: flex;
        gap: 10px;
    }

    .signature-box {
        flex: 1;
        height: 100px;
        border: 1px solid #ddd;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 5px;
    }

    .signature-img {
        width: 100%;
        height: 60px;
        object-fit: contain;
    }

    /* BUTTONS */
    .btn-primary {
        background-color: #2f5ea8;
        border: none;
    }

        .btn-primary:hover {
            background-color: #244a87;
        }

    .btn-success {
        background-color: #3b63a3;
        border: none;
        color: white;
    }

        .btn-success:hover {
            background-color: #2f4f84;
        }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
        color: white;
    }
</style>

@code {
    // Sample Model (bind from DB later)
    public MemberModel Model = new()
    {

    };
    private string[] Fingerprints = new string[16];
    private string path = AppSettings.BaseFolder;
    private List<MemberDropdown> members = new();
    private string? _selectedMemberId;

    private string selectedMemberId
    {
        get => _selectedMemberId;
        set
        {
            if (_selectedMemberId != value)
            {
                _selectedMemberId = value;
                _ = OnMemberChanged(); // call logic
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        members = await LocalStorageService.GetMembersForDropdownAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        string? memberId = query["id"];

        if (!string.IsNullOrEmpty(memberId))
        {
            // Automatic call the onchange func, because @bind call this automatically
            selectedMemberId = memberId;

        }
        StateHasChanged();
    }

    private void UpdateInfo()
    {
        if (string.IsNullOrWhiteSpace(selectedMemberId))
        {
            return;
        }
        Navigation.NavigateTo($"/registration?id=" + selectedMemberId + "");
    }

    private void SelectMember(MemberDropdown item)
    {
        selectedMemberId = item.PersonUniqueId;
    }

    private async Task OnMemberChanged()
    {
        if (!string.IsNullOrEmpty(selectedMemberId))
        {
            await LoadMemberInfo(selectedMemberId);
        }
    }

    private async Task LoadMemberInfo(string memberId)
    {
        if (string.IsNullOrEmpty(memberId))
            return;

        Model = await LocalStorageService.LoadDemographicsAsync(memberId);
        Fingerprints = new string[16];
        string memberFolder = Path.Combine(path, memberId);
        LoadLeftFourFingerprints(memberFolder);
        LoadRightFourFingerprints(memberFolder);
        LoadThumbsFingerprints(memberFolder);
        LoadIris(memberFolder);
        LoadSignature(memberFolder);
        LoadFace(memberFolder);

        StateHasChanged();
    }


    private async void LoadMemberInfo2(string memberId)
    {
        Model = await LocalStorageService.LoadDemographicsAsync(memberId);
        Fingerprints = new string[16];
        string memberFolder = Path.Combine(path, memberId);
        LoadLeftFourFingerprints(memberFolder);
        LoadRightFourFingerprints(memberFolder);
        LoadThumbsFingerprints(memberFolder);
        LoadIris(memberFolder);
        LoadSignature(memberFolder);
        LoadFace(memberFolder);

        StateHasChanged();
    }

    private Task LoadMemberData(string memberId)
    {
        // Fetch or update data based on selected member
        Console.WriteLine($"Selected Member ID: {memberId}");
        return Task.CompletedTask;
    }

    private string GetFingerLabel(int index)
    {
        return index switch
        {
            0 => "LL",
            1 => "LR",
            2 => "LM",
            3 => "LI",
            4 => "LT",
            5 => "RT",
            6 => "RI",
            7 => "RM",
            8 => "RR",
            9 => "RL",
            _ => ""   // ✅ VERY IMPORTANT
        };
    }

    // Highlight active slot
    int currentIndex = 0;
    private string GetSlotClass(int index)
    {
        // if (index == currentIndex)
        //     return "active-finger";

        return "";
    }

    // Fingerprint list

    private void LoadLeftFourFingerprints(string imagePath)
    {
        string[] files =
        {
             "l_Left_Little.bmp",
            "l_Left_Ring.bmp",
            "l_Left_Middle.bmp",
            "l_Left_Index.bmp"

    };

        for (int i = 0; i < files.Length; i++)
        {

            string path = Path.Combine(imagePath, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[i] = Convert.ToBase64String(bytes);

            }
        }


    }

    private void LoadRightFourFingerprints(string imagePath)
    {

        string[] files =
        {
        "r_Right_Index.bmp",
        "r_Right_Middle.bmp",
        "r_Right_Ring.bmp",
        "r_Right_Little.bmp"
    };

        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(imagePath, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[i + 6] = Convert.ToBase64String(bytes);
            }
        }


    }

    private void LoadThumbsFingerprints(string imagePath)
    {

        string[] files =
        {
            "l_Left_Thumb.bmp",
            "r_Right_Thumb.bmp"
     };

        int j = 4;
        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(imagePath, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[j] = Convert.ToBase64String(bytes);
                j = 5;
            }
        }

    }

    private void LoadIris(string imagePath)
    {

        string[] files =
        {
            "left_iris.png",
            "right_iris.png"
        };

        int j = 10;
        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(imagePath, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[j] = Convert.ToBase64String(bytes);
                j++;
            }
        }

    }

    private void LoadSignature(string imagePath)
    {

        string[] files =
        {
            "signature1.jpg",
            "signature2.jpg"
        };

        int j = 12;
        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(imagePath, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[j] = Convert.ToBase64String(bytes);
                j++;
            }
        }

    }
    private void LoadFace(string imagePath)
    {

        string[] files =
        {
            "face.png"
        };

        int j = 14;
        for (int i = 0; i < files.Length; i++)
        {
            string path = Path.Combine(imagePath, files[i]);

            if (File.Exists(path))
            {
                var bytes = File.ReadAllBytes(path);
                Fingerprints[j] = Convert.ToBase64String(bytes);
                j++;
            }
        }

    }




