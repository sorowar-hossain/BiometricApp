@page "/detail-review"
@using BiometricApp.Models
@using BiometricApp.Services
@inject LocalStorageService LocalStorageService

<div class="container main-container">
    <div class="card shadow-sm">

        <!-- HEADER -->
        <div class="card-header text-center header-title">
            Data Capturing System
        </div>

        <div class="card-body">

            <h5 class="text-primary fw-bold">Detail Review</h5>
            <small class="text-muted">Carefully check all your personal information shown on the screen</small>
            <!-- Member Selection -->
            <!-- Member Selection -->
            <div class="member-select">
                <label>Select Member</label>
                <select class="form-control" @bind="selectedMemberId">
                    <option value="">-- Select Member --</option>
                    @foreach (var item in members)
                    {
                        <option value="@item.PersonUniqueId">
                            @item.FullName
                        </option>
                    }
                </select>
            </div>

            <div class="row mt-4">

                <!-- ================= LEFT PANEL (BIOMETRICS) ================= -->
                <div class="col-md-5">
                    <div class="section-box">

                        <h6 class="section-title">Biometrics</h6>

                        <!-- FACE -->
                        <div class="mb-3 text-center">
                            <label class="biometric-label">Face</label>
                            <div class="photo-wrapper">
                                <img src="images/user1.jpg" class="photo-box" />
                            </div>
                        </div>

                        <!-- IRIS -->
                        <div class="mb-3">
                            <label class="biometric-label">Iris</label>
                            <div class="iris-container">
                                <img src="images/left_iris.png" class="iris-img" />
                                <img src="images/right_iris.png" class="iris-img" />
                            </div>
                        </div>

                        <!-- FINGERPRINTS -->
                        <div class="mb-3">
                            <label class="biometric-label">Fingerprints</label>

                            <!-- Hands Layout -->
                            <div class="hands">
                                <!-- LEFT HAND -->
                                <div class="hand-container">
                                    <div class="hand-title">Left Hand</div>
                                    <div class="slots">
                                        @for (int i = 0; i < 4; i++)
                                        {
                                            <div>
                                                <div class="finger-label">@GetFingerLabel(i)</div>
                                                @if (!string.IsNullOrEmpty(Fingerprints[i]))
                                                {
                                                    <img src="@Fingerprints[i]" class="finger-img" />
                                                }
                                            </div>
                                        }
                                    </div>
                                
                                </div>

                                <!-- RIGHT HAND -->
                                <div class="hand-container">
                                    <div class="hand-title">Right Hand</div>
                                    <div class="slots">
                                        @for (int i = 6; i < 10; i++)
                                        {
                                            <div>
                                                <div class="finger-label">@GetFingerLabel(i)</div>
                                                @if (!string.IsNullOrEmpty(Fingerprints[i]))
                                                {
                                                    <img src="@Fingerprints[4]" class="finger-img" />
                                                }
                                            </div>
                                        }
                                    </div>
                                   
                                </div>
                            </div>

                            <!-- THUMBS -->
                            <div class="thumb-section">
                                <div class="slots">
                                    <!-- LEFT THUMB -->
                                    <div>
                                        <div class="finger-label">LT</div>
                                        @if (!string.IsNullOrEmpty(Fingerprints[4]))
                                        {
                                            <img src="@Fingerprints[4]" class="finger-img" />
                                        }
                                    </div>

                                    <!-- RIGHT THUMB -->
                                    <div>
                                        <div class="finger-label">RT</div>
                                        @if (!string.IsNullOrEmpty(Fingerprints[5]))
                                        {
                                            <img src="@Fingerprints[4]" class="finger-img" />
                                        }
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- SIGNATURES -->
                        <div class="mb-3">
                            <label class="biometric-label">Signatures</label>
                            <div class="signature-container">
                                <div class="signature-box">
                                    <small>Signature 1</small>
                                    <img src="images/signature1.jpg" class="signature-img" />
                                </div>

                                <div class="signature-box">
                                    <small>Signature 2</small>
                                    <img src="images/signature2.jpg" class="signature-img" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ================= RIGHT PANEL (PERSONAL INFO) ================= -->
                <div class="col-md-7">
                    <div class="section-box">

                        <h6 class="section-title">Personal Information</h6>

                        <div class="info-row">
                            <label>Full Name</label>
                            <input class="form-control" value="@Model.FirstName @Model.LastName" readonly />
                        </div>

                        <div class="info-row">
                            <label>Date of Birth</label>
                            <input class="form-control" value="@Model.DateOfBirth" readonly />
                        </div>

                        <div class="info-row">
                            <label>Gender</label>
                            <input class="form-control" value="@Model.Gender" readonly />
                        </div>

                        <div class="info-row">
                            <label>Marital Status</label>
                            <input class="form-control" value="@Model.MaritalStatus" readonly />
                        </div>

                        <div class="info-row">
                            <label>Address</label>
                            <textarea class="form-control" rows="3" readonly>@Model.Address</textarea>
                        </div>

                    </div>
                </div>

            </div>

            <!-- FOOTER -->
            <div class="d-flex justify-content-between mt-4">
              @*   <button class="btn btn-secondary px-4">Back</button>
                <button class="btn btn-primary px-4">Done</button> *@
            </div>

        </div>
    </div>
</div>
<style>

    .member-select .form-control {
        width: 100%;
    }

    .top-row {
        display: flex;
        align-items: flex-start; /* aligns with titles */
        gap: 30px;
    }

    .member-select {
        width: 250px;
    }
    .main-container {
        background: #f4f6f9;
        padding: 20px;
    }

    /* HEADER */
    .header-title {
        background: linear-gradient(135deg, #2f5ea8, #4a7bd0);
        color: white;
        font-weight: 600;
        font-size: 18px;
    }

    /* SECTION BOX */
    .section-box {
        border: 1px solid #e0e0e0;
        padding: 15px;
        background: #ffffff;
        border-radius: 6px;
        margin-bottom: 15px;
    }

    /* SECTION TITLES */
    .section-title {
        font-weight: 600;
        margin-bottom: 12px;
        color: #2f5ea8;
    }

    /* PERSONAL INFO ROW */
    .info-row {
        margin-bottom: 12px;
    }

        .info-row label {
            font-weight: 500;
            margin-bottom: 4px;
            display: block;
        }

    /* BIOMETRIC LABELS */
    .biometric-label {
        font-weight: 600;
        display: block;
        margin-bottom: 6px;
        color: #2f5ea8;
    }

    /* FACE IMAGE */
    .photo-wrapper {
        width: 100%;
        height: 180px;
        border: 1px solid #ccc;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .photo-box {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* IRIS */
    .iris-container {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .iris-img {
        width: 48%;
        height: 80px;
        object-fit: cover;
        border: 1px solid #ccc;
    }

    /* HANDS FINGERPRINTS */
    .hands {
        display: flex;
        justify-content: center;
        gap: 50px;
        margin-bottom: 15px;
    }

    .hand-container {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hand-title {
        font-weight: bold;
        margin-bottom: 8px;
        color: white;
        font-size: 14px;
        background: #3b63a3;
        padding: 4px 12px;
        border-radius: 12px;
    }

    /* FINGER SLOTS */
    .slots {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .slot {
        width: 60px;
        height: 80px;
        border: 2px solid #3b63a3;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        background: #f9f9f9;
    }

        .slot.completed {
            background: #d4edda;
            border-color: #28a745;
        }

    .finger-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }
    /* FINGER SLOTS */
    .slots .finger-img {
        width: 135%; /* slightly bigger than before (was 110%) */
        height: 135%; /* slightly bigger */
        object-fit: contain;
    }


    .finger-label {
        position: absolute;
        top: 2px;
        left: 2px;
        font-size: 10px;
        font-weight: bold;
        background: rgba(255, 255, 255, 0.8);
        padding: 1px 3px;
        border-radius: 3px;
    }

    /* THUMB SECTION */
    .thumb-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 10px;
    }

        .thumb-section .slots {
            display: flex;
            gap: 20px;
        }

        .thumb-section .slot {
            width: 70px;
            height: 70px;
            border: 2px solid #3b63a3;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .thumb-section .finger-img {
            width: 65%;
            height: auto;
            object-fit: contain;
            height:65%
        }

    /* SIGNATURES */
    .signature-container {
        display: flex;
        gap: 10px;
    }

    .signature-box {
        flex: 1;
        height: 100px;
        border: 1px solid #ddd;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 5px;
    }

    .signature-img {
        width: 100%;
        height: 60px;
        object-fit: contain;
    }

    /* BUTTONS */
    .btn-primary {
        background-color: #2f5ea8;
        border: none;
    }

        .btn-primary:hover {
            background-color: #244a87;
        }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
        color: white;
    }

    .btn-success {
        background-color: #3b63a3;
        border: none;
        color: white;
    }

        .btn-success:hover {
            background-color: #2f4f84;
        }
</style>

@code {
    // Sample Model (bind from DB later)
    public MemberModel Model = new()
    {
      
    };

    private string path = AppSettings.BaseFolder;
    private List<MemberDropdown> members = new();
    private string selectedMemberId;

    protected override async Task OnInitializedAsync()
    {
        members = await LocalStorageService.GetMembersForDropdownAsync();
    }
    private void SelectMember(MemberDropdown item)
    {
        selectedMemberId = item.PersonUniqueId;
    }

    private string GetFingerLabel(int index)
    {
        return index switch
        {
            0 => "LL", // Left Little
            1 => "LR", // Left Ring
            2 => "LM", // Left Middle
            3 => "LI", // Left Index
            4 => "LT", // Left Thumb

            5 => "RT", // Right Thumb
            6 => "RI", // Right Index
            7 => "RM", // Right Middle
            8 => "RR", // Right Ring
            9 => "RL", // Right Little

        };
    }
    // Fingerprint list
    public List<string> Fingerprints = new()
    {
        "images/fingerprint1.jpg",
        "images/fingerprint2.jpg",
        "images/fingerprint1.jpg",
        "images/fingerprint1.jpg",
        "images/fingerprint1.jpg",
        "images/fingerprint1.jpg",
        "images/fingerprint1.jpg",
        "images/fingerprint1.jpg",
        "images/fingerprint1.jpg",
        "images/fingerprint1.jpg"
    };

    void GoBack()
    {
        // Navigation logic
    }

    void Submit()
    {
        // Save / submit logic
    }

    public class UserModel
    {
        public string FullName { get; set; }
        public string DateOfBirth { get; set; }
        public string Gender { get; set; }
        public string CivilStatus { get; set; }
        public string Address { get; set; }
    }
}