@page "/biometric-enrollment"
@layout EmptyLayout
@using BiometricApp.Components.Layout
@using BiometricApp.Models
@using BiometricApp.Services
@inject UserService UserService
@inject UserSessionService SessionService
@inject NavigationManager NavigationManager

<div class="enrollment-container">

    <!-- PAGE TITLE -->
    <div class="page-header mb-3 sticky-header">
        <div>
            <h3 class="mb-0"><span class="page-header_content">Biometric Enrollment</span></h3>
        </div>

        <div>
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-success py-2 mb-3 fade-message @(isVisible ? "show" : "hide")">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <span class="message-text">@message</span>
                </div>
            }
        </div>
        <div class="new_regis_btn">
            @if(IsShowBackBtn)
            {
                <button class="btn back-btn" @onclick="GoBack">
                    <i class="bi bi-arrow-left-circle-fill me-1"></i>
                    Back
                </button>

            }
            @if (IsShowDtlsBtn)
            {
                <button class="btn"
                          type="button"
                          @onclick="ClearAll">
                    <i class="bi bi-person-plus"></i>
                    New Registration
                </button>
                <button class="btn"
                        type="button"
                        @onclick="GoToDetailsPage">
                    <i class="bi bi-journal-text"></i>
                    Details
                </button>
                
            }

            @if (IsShowDbSycBtn)
            {
                <button class="btn"
                        type="button"
                        @onclick="GoToSavePage">

                    <i class="bi bi-database-fill"></i>
                    Save to DB
                </button>
            }
         
               
            
            <button class="btn"
                    type="button"
                    @onclick="GoToLogout">
                <i class="bi bi-box-arrow-right"></i>
                Logout
            </button>
        </div>
    </div>

    <!-- MAIN CONTENT -->

    <div class="container-fluid">
        @if (!IsShowDetails && !IsShowDBSyn)
        {
            <!-- DEMOGRAPHIC -->
            <div class="row mb-3">
                <div class="col-12">
                    <div class="module-card">
                        <div class="module-header">
                            <i class="bi bi-person-vcard"></i>
                            Demographic Data
                        </div>
                        <div class="module-body">
                            <Registration OnActionMessage="ShowMessage" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- FACE -->
            <div class="row mb-3">
                <div class="col-12">
                    <div class="module-card">
                        <div class="module-header">
                            <i class="bi bi-camera"></i>
                            <h5>Face Capture</h5>
                        </div>
                        <div class="module-body">
                            <Face OnActionMessage="ShowMessage" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- FINGERPRINT -->
            <div class="row mb-3">
                <div class="col-12">
                    <div class="module-card">
                        <div class="module-header">
                            <i class="bi bi-fingerprint"></i>
                            Fingerprint Capture
                        </div>
                        <div class="module-body">
                            <Finger OnActionMessage="ShowMessage" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- IRIS -->
            <div class="row mb-3">
                <div class="col-12">
                    <div class="module-card">
                        <div class="module-header">
                            <i class="bi bi-eye"></i>
                            Iris Capture
                        </div>
                        <div class="module-body">
                            <Iris OnActionMessage="ShowMessage" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- SIGNATURE -->
            <div class="row mb-3">
                <div class="col-12">
                    <div class="module-card">
                        <div class="module-header">
                            <i class="bi bi-pen"></i>
                            Signature Capture
                        </div>
                        <div class="module-body">
                            <Signature OnActionMessage="ShowMessage" />
                        </div>
                    </div>
                </div>
            </div>
        }
     
        <!-- Details -->
        @if (IsShowDetails)
        {
            <div class="row mb-3">
                <div class="col-12">
                    <div class="module-card">
                        <div class="module-header">
                            <i class="bi bi-clipboard-check"></i>
                            <h5>Detail Review</h5>
                        </div>
                        <div class="module-body">
                            <DetailReview />
                        </div>
                    </div>
                </div>
            </div>
        }


        <!-- Save to db -->
        @if (IsShowDBSyn)
        {
            <div class="row mb-3">
                <div class="col-12">
                    <div class="module-card">
                        <div class="module-header">
                            <i class="bi bi-arrow-repeat"></i>
                            <h5>Data Synchronize</h5>
                        </div>
                        <div class="module-body">
                            <DataExport />
                        </div>
                    </div>
                </div>
            </div>
        }
      

    </div>

</div>

<style>
    .page-header_content{
        color:white;
    }
    .label-custom {
        font-size: 18px;
        font-weight: 600;
        color: #34495e;
        margin-bottom: 6px;
        display: block;
    }
    .sticky-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: #ffffff;
        padding: 12px 16px;
        border-bottom: 1px solid #e5e5e5;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .enrollment-container {
        background: #f4f6f9;
        min-height: calc(100vh - 60px);
    }

    /* HEADER */
    .page-header {
        background: #009639;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        display: flex;
        justify-content: space-between;
        align-items: center;
        color:white;
    }

    /* MODULE CARD */
    .module-card {
        background: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(245, 206, 0, 0.25);
        border: 3px solid #FFC700;
    }

    /* HEADER */
    .module-header {
        padding: 14px 18px;
        font-size: 20px;
        font-weight: 600;
        background: #f8fafc;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        align-items: center;
        gap: 10px;
        background-color: #009639;
        color:white;
    }

    /* BODY */
    .module-body {
        padding: 16px;
    }

    /* ICON */
    .module-header i {
        font-size: 18px;
    }

    /* RESPONSIVE */
    @@media(max - width: 992px)

    {
        .page-header

    {
        flex-direction: column;
        gap: 10px;
        align-items: flex-start;
    }

    }

    .form-label-custom {
        font-size: 16px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 6px;
        display: block;
    }

    .save-btn {
        min-width: 140px;
        height: 50px;
        font-size: 18px;
        font-weight: 600;
        border-radius: 10px;
    }

    .alert-success {
        border-radius: 10px;
        font-weight: 500;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .message-text {
        font-size: 18px;
    }

    .fade-message {
        opacity: 0;
        transform: translateY(-5px);
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

        .fade-message.show {
            opacity: 1;
            transform: translateY(0);
        }

        .fade-message.hide {
            opacity: 0;
            transform: translateY(-5px);
        }

    .new_regis_btn {
        display: flex;
        gap: 15px;
    }
    .new_regis_btn button{
        display: flex;
        align-items: center;
        gap: 5px;
        border: 3px solid #FFC700;
        color:white;
        font-weight:bold;
    }

    .new_regis_btn button:hover {
        border: 3px solid #FFC700;
    }
</style>

@code{
    private UserLoginResponse user = new();
    public string message = "";
    private bool isVisible;
    private string personUniqueId;
    private bool IsShowDetails = false;
    private bool IsShowDBSyn = false;
    private bool IsShowBackBtn = false;
    private bool IsShowDtlsBtn = true;
    private bool IsShowDbSycBtn = true;


    protected override async Task OnInitializedAsync()
    {
        // Get current user
        user = UserService.CurrentUser;
        var id = CreateMemberId();
        SessionService.SetUser(new UserLoginResponse
        {
            PersonUniqueId = id,
            UserName = user.UserName
        });

        StateHasChanged();
    }


    private void ReceivePersonId(string id)
    {
        personUniqueId = id;
    }

    private async Task ShowMessage()
    {
        message = "Data Saved Successfully..";
        isVisible = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(1000);

        isVisible = false;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(300); // match fade duration

        message = null;
        await InvokeAsync(StateHasChanged);
    }


    private void ClearAll()
    {
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private int GetNextMemberSequence()
    {
        string baseFolder = AppSettings.BaseFolder;

        // Create base folder if not exists
        if (!Directory.Exists(baseFolder))
        {
            Directory.CreateDirectory(baseFolder);
            return 1; // first member starts from 1 (000001)
        }

        // Get all member folders
        var allFolders = Directory.GetDirectories(baseFolder);

        if (allFolders.Length == 0)
            return 1;

        // Next sequence = folder count + 1
        return allFolders.Length + 1;
    }


    private string CreateMemberId()
    {
        string userName = user.UserName;

        int seq = GetNextMemberSequence();

        // 000001 format
        string seqStr = seq.ToString("D6");

        string id = $"BIO{userName}{DateTime.Now:yyyyMMdd}{seqStr}";

        return id;
    }

    private void GoToLogout()
    {
        IsShowDetails = false;
        IsShowDBSyn = false;
        NavigationManager.NavigateTo("/");
    }
    private void GoToSavePage()
    {
        IsShowDBSyn = true;
        IsShowDetails = false;
        IsShowBackBtn = true;
        IsShowDbSycBtn = false;
        IsShowDtlsBtn = false;
        StateHasChanged();
        // NavigationManager.NavigateTo("/save-to-database");
    }
    private void GoToDetailsPage()
    {
        IsShowDetails = true;
        IsShowDBSyn = false;
        IsShowBackBtn = true;
        IsShowDbSycBtn = false;
        IsShowDtlsBtn = false;
        StateHasChanged();
        // NavigationManager.NavigateTo($"/detail-review");
    }
    private void TestPrinter()
    {
        NavigationManager.NavigateTo("/printer-test");
    }
    private void GoBack()
    {
        IsShowDetails = false;
        IsShowDBSyn = false;
        IsShowBackBtn = false;
        IsShowDtlsBtn = true;
        IsShowDbSycBtn = true;
        StateHasChanged();
    }
}