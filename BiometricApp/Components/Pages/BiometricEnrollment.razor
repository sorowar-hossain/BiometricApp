@page "/biometric-enrollment"
@layout EmptyLayout
@using BiometricApp.Components.Layout
@using BiometricApp.Models
@using BiometricApp.Services
@inject UserService UserService
@inject UserSessionService SessionService
@inject NavigationManager NavigationManager

<div class="container-fluid enrollment-container">

    <!-- PAGE TITLE -->
    <div class="page-header mb-3 sticky-header">
        <div>
            <h3 class="mb-0">Biometric Enrollment</h3>
        </div>

        <div>
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-success py-2 mb-3 fade-message @(isVisible ? "show" : "hide")">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <span class="message-text">@message</span>
                </div>
            }
        </div>
        <div>
            <button class="btn btn-info"
                    type="button"
                    @onclick="ClearAll">
                <i class="bi bi-person-plus"></i>
                New Registration
            </button>
        </div>
    </div>

    <!-- MAIN CONTENT -->

    <div class="container-fluid">

        <!-- DEMOGRAPHIC -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-person-vcard"></i>
                        Demographic Data
                    </div>
                    <div class="module-body">
                        <Registration OnActionMessage="ShowMessage" />
                    </div>
                </div>
            </div>
        </div>

        <!-- FACE -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-camera"></i>
                        Face Capture
                    </div>
                    <div class="module-body">
                        <Face />
                    </div>
                </div>
            </div>
        </div>

        <!-- FINGERPRINT -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-fingerprint"></i>
                        Fingerprint Capture
                    </div>
                    <div class="module-body">
                        <Finger />
                    </div>
                </div>
            </div>
        </div>

        <!-- IRIS -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-eye"></i>
                        Iris Capture
                    </div>
                    <div class="module-body">
                        <Iris OnActionMessage="ShowMessage" />
                    </div>
                </div>
            </div>
        </div>

        <!-- SIGNATURE -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-pen"></i>
                        Signature Capture
                    </div>
                    <div class="module-body">
                        <Signature />
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<style>
    .label-custom {
        font-size: 18px;
        font-weight: 600;
        color: #34495e;
        margin-bottom: 6px;
        display: block;
    }
    .sticky-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: #ffffff;
        padding: 12px 16px;
        border-bottom: 1px solid #e5e5e5;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .enrollment-container {
        padding: 12px;
        background: #f4f6f9;
        min-height: calc(100vh - 60px);
    }

    /* HEADER */
    .page-header {
        background: #ffffff;
        border-radius: 14px;
        padding: 16px 20px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* MODULE CARD */
    .module-card {
        background: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        border: 1px solid #e9ecef;
       
    }

    /* HEADER */
    .module-header {
        padding: 14px 18px;
        font-size: 20px;
        font-weight: 600;
        background: #f8fafc;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* BODY */
    .module-body {
        padding: 16px;
    }

    /* ICON */
    .module-header i {
        font-size: 18px;
        color: #0d6efd;
    }

    /* RESPONSIVE */
    @@media(max - width: 992px)

    {
        .page-header

    {
        flex-direction: column;
        gap: 10px;
        align-items: flex-start;
    }

    }

    .form-label-custom {
        font-size: 16px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 6px;
        display: block;
    }

    .save-btn {
        min-width: 140px;
        height: 50px;
        font-size: 18px;
        font-weight: 600;
        border-radius: 10px;
    }

    .alert-success {
        border-radius: 10px;
        font-weight: 500;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .message-text {
        font-size: 18px;
    }

    .fade-message {
        opacity: 0;
        transform: translateY(-5px);
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

        .fade-message.show {
            opacity: 1;
            transform: translateY(0);
        }

        .fade-message.hide {
            opacity: 0;
            transform: translateY(-5px);
        }
</style>

@code{
    private UserLoginResponse user = new();
    public string message = "";
    private bool isVisible;
    protected override async Task OnInitializedAsync()
    {
        // Get current user
        user = UserService.CurrentUser;
        var id = CreateMemberId();
        SessionService.SetUser(new UserLoginResponse
        {
            PersonUniqueId = id,
            UserName = user.UserName
        });

        StateHasChanged();
    }

    private async Task ShowMessage()
    {
        message = "Data Saved Successfully..";
        isVisible = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(1000);

        isVisible = false;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(300); // match fade duration

        message = null;
        await InvokeAsync(StateHasChanged);
    }


    private void ClearAll()
    {
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private int GetNextMemberSequence()
    {
        string baseFolder = AppSettings.BaseFolder;

        // Create base folder if not exists
        if (!Directory.Exists(baseFolder))
        {
            Directory.CreateDirectory(baseFolder);
            return 1; // first member starts from 1 (000001)
        }

        // Get all member folders
        var allFolders = Directory.GetDirectories(baseFolder);

        if (allFolders.Length == 0)
            return 1;

        // Next sequence = folder count + 1
        return allFolders.Length + 1;
    }


    private string CreateMemberId()
    {
        string userName = user.UserName;

        int seq = GetNextMemberSequence();

        // 000001 format
        string seqStr = seq.ToString("D6");

        string id = $"BIO{userName}{DateTime.Now:yyyyMMdd}{seqStr}";

        return id;
    }
}