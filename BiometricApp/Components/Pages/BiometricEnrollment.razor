@page "/biometric-enrollment"
@using BiometricApp.Models
@using BiometricApp.Services
@inject UserService UserService
@inject UserSessionService SessionService
@inject NavigationManager NavigationManager

<div class="container-fluid enrollment-container">

    <!-- PAGE TITLE -->
    <div class="page-header mb-3 sticky-header">
        <div>
            <h3 class="mb-0">Biometric Enrollment</h3>
        </div>

        <div>
            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-success py-2">
                    @message
                </div>
            }
        </div>
        <div>
            <button class="btn btn-danger"
                    type="button"
                    @onclick="ClearAll">
                <i class="bi bi-x-circle"></i>
                Clear All
            </button>
        </div>
    </div>

    <!-- MAIN CONTENT -->

    <div class="container-fluid">

        <!-- DEMOGRAPHIC -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-person-vcard"></i>
                        Demographic Data
                    </div>
                    <div class="module-body">
                        <Registration OnActionMessage="ShowMessage" />
                    </div>
                </div>
            </div>
        </div>

        <!-- FACE -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-camera"></i>
                        Face Capture
                    </div>
                    <div class="module-body">
                        <Face />
                    </div>
                </div>
            </div>
        </div>

        <!-- FINGERPRINT -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-fingerprint"></i>
                        Fingerprint Capture
                    </div>
                    <div class="module-body">
                        <Finger />
                    </div>
                </div>
            </div>
        </div>

        <!-- IRIS -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-eye"></i>
                        Iris Capture
                    </div>
                    <div class="module-body">
                        <Iris />
                    </div>
                </div>
            </div>
        </div>

        <!-- SIGNATURE -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-pen"></i>
                        Signature Capture
                    </div>
                    <div class="module-body">
                        <Signature />
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<style>

    .sticky-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: #ffffff;
        padding: 12px 16px;
        border-bottom: 1px solid #e5e5e5;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .enrollment-container {
        padding: 12px;
        background: #f4f6f9;
        min-height: calc(100vh - 60px);
    }

    /* HEADER */
    .page-header {
        background: #ffffff;
        border-radius: 14px;
        padding: 16px 20px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* MODULE CARD */
    .module-card {
        background: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        border: 1px solid #e9ecef;
       
    }

    /* HEADER */
    .module-header {
        padding: 14px 18px;
        font-size: 15px;
        font-weight: 600;
        background: #f8fafc;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* BODY */
    .module-body {
        padding: 16px;
    }

    /* ICON */
    .module-header i {
        font-size: 18px;
        color: #0d6efd;
    }

    /* RESPONSIVE */
    @@media(max - width: 992px)

    {
        .page-header

    {
        flex-direction: column;
        gap: 10px;
        align-items: flex-start;
    }

    }

    .form-label-custom {
        font-size: 16px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 6px;
        display: block;
    }

</style>

@code{
    private UserLoginResponse user = new();
    public string message = "";
    protected override async Task OnInitializedAsync()
    {
        // Get current user
        user = UserService.CurrentUser;
        var id = CreateMemberId();
        SessionService.SetUser(new UserLoginResponse
        {
            PersonUniqueId = id,
            UserName = user.UserName
        });

        StateHasChanged();
    }

    private async Task ShowMessage(string msg)
    {
        message = msg;
        StateHasChanged();
    }


    private void ClearAll()
    {
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }

    private int GetNextMemberSequence()
    {
        // Absolute path for members
        string baseFolder = AppSettings.BaseFolder;

        // Create the folder if it doesn't exist
        if (!Directory.Exists(baseFolder))
        {
            Directory.CreateDirectory(baseFolder);
            return 1; // no members yet
        }

        // Get all subfolders (each folder = one member)
        var allFolders = Directory.GetDirectories(baseFolder);

        if (allFolders.Length == 0)
            return 1; // no members yet

        // Count members created today (optional, or just use total folders)
        int maxSequence = 0;

        foreach (var folder in allFolders)
        {
            string jsonPath = Path.Combine(folder, "demographics.json");
            if (File.Exists(jsonPath))
            {
                var json = File.ReadAllText(jsonPath);
                var member = System.Text.Json.JsonSerializer.Deserialize<MemberModel>(json);
                if (member != null)
                {
                    // Extract last 6-7 digits from PersonUniqueId if your ID stores sequence
                    // Or simply count existing members and take max + 1
                    maxSequence++;
                }
            }
        }

        return maxSequence + 1; // next sequence number
    }


    private string CreateMemberId()
    {
        string userName = user.UserName;
        int seq = GetNextMemberSequence();

        // Format sequence as 6-digit or 7-digit number with leading zeros
        string seqStr = seq.ToString("D6"); // 000001, 000002, etc.

        // Include username + datetime + sequence
        string id = $"BIO.{userName}.{DateTime.Now:yyyyMMddHHmm}.{seqStr}";

        return id;
    }
}