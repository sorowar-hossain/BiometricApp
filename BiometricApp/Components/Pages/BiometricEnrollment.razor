@page "/biometric-enrollment"

<div class="container-fluid enrollment-container">

    <!-- PAGE TITLE -->
    <div class="page-header mb-3">
        <div>
            <h3 class="mb-0">Biometric Enrollment</h3>
           @*  <small class="text-muted">
                Demographic and Biometric Data Capture
            </small> *@
        </div>

        <div>
            <button class="btn btn-success">
                <i class="bi bi-check-circle"></i>
                Save Enrollment
            </button>
        </div>
    </div>

    <!-- MAIN CONTENT -->

    <div class="container-fluid">

        <!-- DEMOGRAPHIC -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-person-vcard"></i>
                        Demographic Data
                    </div>
                    <div class="module-body">
                        <Registration />
                    </div>
                </div>
            </div>
        </div>

        <!-- FACE -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-camera"></i>
                        Face Capture
                    </div>
                    <div class="module-body">
                        <Face />
                    </div>
                </div>
            </div>
        </div>

        <!-- FINGERPRINT -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-fingerprint"></i>
                        Fingerprint Capture
                    </div>
                    <div class="module-body">
                        <Finger />
                    </div>
                </div>
            </div>
        </div>

        <!-- IRIS -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-eye"></i>
                        Iris Capture
                    </div>
                    <div class="module-body">
                        <Iris />
                    </div>
                </div>
            </div>
        </div>

        <!-- SIGNATURE -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="module-card">
                    <div class="module-header">
                        <i class="bi bi-pen"></i>
                        Signature Capture
                    </div>
                    <div class="module-body">
                        <Signature />
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<style>
    .enrollment-container {
        padding: 12px;
        background: #f4f6f9;
        min-height: calc(100vh - 60px);
    }

    /* HEADER */
    .page-header {
        background: #ffffff;
        border-radius: 14px;
        padding: 16px 20px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* MODULE CARD */
    .module-card {
        background: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
        border: 1px solid #e9ecef;
       
    }

    /* HEADER */
    .module-header {
        padding: 14px 18px;
        font-size: 15px;
        font-weight: 600;
        background: #f8fafc;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* BODY */
    .module-body {
        padding: 16px;
    }

    /* ICON */
    .module-header i {
        font-size: 18px;
        color: #0d6efd;
    }

    /* RESPONSIVE */
    @@media(max - width: 992px)

    {
        .page-header

    {
        flex-direction: column;
        gap: 10px;
        align-items: flex-start;
    }

    }

    .form-label-custom {
        font-size: 16px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 6px;
        display: block;
    }

</style>

