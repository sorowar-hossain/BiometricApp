@page "/signature"
@using BiometricApp.Services

@inject SignatureService signatureService

<div class="container mt-4 main-box">

    <!-- Header -->
   @*  <div class="header text-center">
        Data Capturing System
    </div> *@

    <div class="p-4">

        <!-- Title -->
      @*   <h5 class="fw-bold text-primary">
            Capture Signature
        </h5>

        <p class="text-muted small">
            Please sign on IMD device
        </p> *@

        <div class="row mt-4">

            <!-- LEFT -->
            <div class="col-md-6 text-center">

                <div class="signature-box">

                    @if (IsCapturing)
                    {
                        <div class="capture-text">
                            Waiting for signature...
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(LiveSignatureBase64))
                    {
                        <img src="@LiveSignatureBase64"
                             class="full-preview-img" />
                    }
                    else
                    {
                        <div class="capture-text">
                            No Signature
                        </div>
                    }

                </div>

                <!-- Buttons -->
                <div class="mt-3">

                    <button class="btn btn-primary px-4 me-2"
                            @onclick="CaptureSignature">
                        <i class="bi bi-pen me-1"></i> Capture
                    </button>
                    <button class="btn btn-dark px-4"
                            @onclick="ClearSignature" disabled="@(isProcessing)">
                        <i class="bi bi-eraser me-1"></i> Clear
                    </button>
                    <button class="btn btn-success px-4 me-2"
                            @onclick="SaveSignature" disabled="@(isProcessing)">
                        <i class="bi bi-check2-circle me-1"></i> Save
                    </button>

                    

                </div>

            </div>

            <!-- RIGHT -->
            <div class="col-md-6">

                <div class="full-preview-box">

                    @if (IsCapturing)
                    {
                        <div class="preview-placeholder">
                            Please sign on device...
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(SignatureBase64))
                    {
                        <img src="@SignatureBase64"
                             class="full-preview-img" />
                    }
                    else
                    {
                        <div class="preview-placeholder">
                            Signature Preview
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .main-box {
        border: none;
        background: #f8f9fa;
        height:auto;
    }

    .header {
        background-color: #2f5597;
        color: white;
        padding: 10px;
        font-weight: bold;
    }

    .signature-box {
        width: 100%;
        max-width: 480px;
        height: 240px;
        border: 2px solid #1f4b99;
        border-radius: 12px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin: 0 auto;
    }

    .signature-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .capture-text {
        color: #666;
        font-weight: bold;
    }

    .preview-box {
        width: 220px;
        height: 60px;
        border: 2px solid #4a86e8;
        background: white;
        overflow: hidden;
    }

    .preview-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .full-preview-box {
        width: 100%;
        max-width: 480px;
        height: 240px;
        border: 2px solid #1f4b99;
        border-radius: 12px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin: 0 auto;
    }

    .full-preview-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        padding: 10px;
    }

    .preview-placeholder {
        font-size: 16px;
        font-weight: 600;
        color: #666;
        text-align: center;
        padding: 10px;
    }

</style>

@code {

    private string? LiveSignatureBase64;
    private string? SignatureBase64;
    private CancellationTokenSource? _cts;
    private bool IsCapturing = false;
    bool isProcessing = true;
    static string path = "";

    protected override async Task OnInitializedAsync()
    {
        isProcessing = true;
        path = "";
        IsCapturing = false;
    }

    private async Task CaptureSignature()
    {
        _cts = new CancellationTokenSource();

        LiveSignatureBase64 = null;

        StateHasChanged();

        // START LIVE PREVIEW LOOP
        _ = Task.Run(async () =>
        {
            await signatureService.StartLivePreviewAsync(
                frame =>
                {
                    LiveSignatureBase64 =
                        $"data:image/png;base64,{Convert.ToBase64String(frame)}";

                    InvokeAsync(StateHasChanged);
                },
                _cts.Token);
        });
        // START ACTUAL CAPTURE
        path = await signatureService.CaptureSignatureAsync();

        _cts.Cancel();

        if (!string.IsNullOrEmpty(path) && File.Exists(path))
        {
            isProcessing = false;
        }

        StateHasChanged();
    }

    private async Task SaveSignature()
    {
        if (!string.IsNullOrEmpty(path) && File.Exists(path))
        {

            byte[] bytes = await File.ReadAllBytesAsync(path);

            SignatureBase64 =
                $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
            path = "";
        }

        StateHasChanged();
    }

    private Task ClearSignature()
    {
        LiveSignatureBase64 = null;
        path = "";
        isProcessing = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

}