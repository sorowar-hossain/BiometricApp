@page "/signature"
@using BiometricApp.Models
@using BiometricApp.Services
@using System.Text.Json
@inject UserSessionService SessionService

@inject SignatureService signatureService

<div class="container-fluid">
    <div class="row">
        <!-- LEFT -->
        <div class="col-md-4">
            <div class="analytics-card">
                <div class="analytics-header">
                    <i class="bi bi-pencil-fill"></i>
                    <h5>Live Signature</h5>
                </div>
                <div class="analytics-content">
                    <div class="signature-box">

                        @if (IsCapturing)
                        {
                            <div class="capture-text">
                                Waiting for signature...
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(LiveSignatureBase64))
                        {
                            <img src="@LiveSignatureBase64"
                                 class="full-preview-img" />
                        }
                        else
                        {
                            <div class="capture-text">
                                No Signature
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="analytics-card">
                <div class="analytics-header">
                    <i class="bi bi-check-circle-fill"></i>
                    <h5>Status</h5>
                </div>
                <div class="analytics-content">
                    <div class="analytics-item">
                        <h6>@status</h6>
                    </div>
                </div>
            </div>
            <div class="text-center">
                <div class="mt-3">
                    <button class="btn btn-primary save-btn"
                            @onclick="CaptureSignature">
                        <i class="bi bi-pen me-1"></i> Capture
                    </button>
                </div>
                <div class="mt-3">
                    <button class="btn btn-warning save-btn"
                            @onclick="ClearSignature"
                            disabled="@(isProcessing)">
                        <i class="bi bi-arrow-repeat"></i> Retake
                    </button>
                </div>
                <div class="mt-3">
                    <button class="btn btn-success save-btn"
                            @onclick="SaveSignature"
                            disabled="@(isProcessing)">
                        <i class="bi bi-check2-circle me-1"></i> Save
                    </button>
                </div>
            </div>
        </div>
        <!-- RIGHT -->
        <div class="col-md-4">
            <div class="analytics-card">
                <div class="analytics-header">
                    <i class="bi bi-pencil-fill"></i>
                    <h5>Preview Signature</h5>
                </div>
                <div class="analytics-content">
                    <div class="full-preview-box">

                        @if (IsCapturing)
                        {
                            <div class="preview-placeholder">
                                Please sign on device...
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(SignatureBase64))
                        {
                            <img src="@SignatureBase64"
                                 class="full-preview-img" />
                        }
                        else
                        {
                            <div class="preview-placeholder">
                                Signature Preview
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>

    .main-box {
        border: none;
        background: #f8f9fa;
        height: auto;
    }

    .header {
        background-color: #2f5597;
        color: white;
        padding: 10px;
        font-weight: bold;
    }

    .signature-box {
        width: 100%;
        max-width: 480px;
        height: 240px;
        border: 2px solid #1f4b99;
        border-radius: 12px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin: 0 auto;
    }

    .signature-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .capture-text {
        color: #666;
        font-weight: bold;
    }

    .preview-box {
        width: 220px;
        height: 60px;
        border: 2px solid #4a86e8;
        background: white;
        overflow: hidden;
    }

    .preview-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .full-preview-box {
        width: 100%;
        max-width: 480px;
        height: 240px;
        border: 2px solid #1f4b99;
        border-radius: 12px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin: 0 auto;
    }

    .full-preview-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        padding: 10px;
    }

    .preview-placeholder {
        font-size: 16px;
        font-weight: 600;
        color: #666;
        text-align: center;
        padding: 10px;
    }

    .save-btn {
        width: 145px;
    }
</style>

@code {

    private string? LiveSignatureBase64;
    private string? SignatureBase64;
    private CancellationTokenSource? _cts;
    private bool IsCapturing = false;
    bool isProcessing = true;
    static string path = "";
    static string folder = "";
    private string PersonUniqueId = "";
    private string status = "";
    [Parameter]
    public EventCallback<string> OnActionMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        isProcessing = true;
        IsCapturing = false;
        PersonUniqueId = SessionService.User.PersonUniqueId;
        path = Path.Combine(AppSettings.BaseFolder, PersonUniqueId);
        folder = Path.Combine(AppSettings.BaseFolder, PersonUniqueId);
    }

    private async Task CaptureSignature()
    {
        _cts = new CancellationTokenSource();

        LiveSignatureBase64 = null;
        status = "";
        bool res = await signatureService.ResetDevice();
        if (!res)
        {
            status = "Device Reset Failed..!";
            StateHasChanged();
            return;
        }
        else
        {
            status = "Device Ready";
        }

        StateHasChanged();

        // START LIVE PREVIEW LOOP
        _ = Task.Run(async () =>
        {
            await signatureService.StartLivePreviewAsync(
                frame =>
                {
                    LiveSignatureBase64 =
                        $"data:image/png;base64,{Convert.ToBase64String(frame)}";

                    InvokeAsync(StateHasChanged);
                },
                _cts.Token);
        });
        // START ACTUAL CAPTURE
        path = await signatureService.CaptureSignatureAsync(path);

        _cts.Cancel();

        if (!string.IsNullOrEmpty(path) && File.Exists(path))
        {
            isProcessing = false;

        }

        else
        {
            path = Path.Combine(AppSettings.BaseFolder, PersonUniqueId);
        }

        StateHasChanged();
    }


    private async Task SaveSignature()
    {

        if (File.Exists(path))
        {

            byte[] bytes = await File.ReadAllBytesAsync(path);

            string signatureBase64 =
                 $"data:image/png;base64,{Convert.ToBase64String(bytes)}";

            await signatureService.SaveSignature(signatureBase64, folder);

            path = Path.Combine(AppSettings.BaseFolder, PersonUniqueId);
            await ShowSignature();

        }


    }


    private async Task ShowSignature()
    {

        string jsonPath = Path.Combine(folder, "signature.json");

        if (File.Exists(jsonPath))
        {
            string json = await File.ReadAllTextAsync(jsonPath);

            var signatureData = JsonSerializer.Deserialize<SignatureData>(json);

            if (!string.IsNullOrWhiteSpace(signatureData?.SignatureImage))
            {
                SignatureBase64 = signatureData.SignatureImage;

                await signatureService.SaveSignature(SignatureBase64, folder);

                path = Path.Combine(AppSettings.BaseFolder, PersonUniqueId);

                await OnActionMessage.InvokeAsync("Saved");
            }
        }

        StateHasChanged();
    }

    private async Task ClearSignature()
    {
        LiveSignatureBase64 = null;
        SignatureBase64 = null;
        path = Path.Combine(AppSettings.BaseFolder, PersonUniqueId);
        isProcessing = true;
        status = "";
        StateHasChanged();

    }

}