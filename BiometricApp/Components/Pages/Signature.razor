@page "/signature"
@using BiometricApp.Services

@inject SignatureService signatureService

<div class="container mt-4 main-box">

    <!-- Header -->
    <div class="header text-center">
        Data Capturing System
    </div>

    <div class="p-4">

        <!-- Title -->
        <h5 class="fw-bold text-primary">
            Capture Signature
        </h5>

        <p class="text-muted small">
            Please sign on IMD device
        </p>

        <div class="row mt-4">

            <!-- LEFT -->
            <div class="col-md-6 text-center">

                <div class="signature-box">

                    @if (IsCapturing)
                    {
                        <div class="capture-text">
                            Waiting for signature...
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(SignatureBase64))
                    {
                        <div class="capture-text">
                            Signature Completed...
                        </div>
                    }
                    else
                    {
                        <div class="capture-text">
                            No Signature
                        </div>
                    }

                </div>

                <!-- Buttons -->
                <div class="mt-3">

                    <button class="btn btn-primary px-4 me-2"
                            @onclick="CaptureSignature">
                        Capture Signature
                    </button>

                    <button class="btn btn-dark px-4"
                            @onclick="ClearSignature">
                        Reset
                    </button>

                </div>

            </div>

            <!-- RIGHT -->
            <div class="col-md-6">

                <div class="full-preview-box">

                    @if (IsCapturing)
                    {
                        <div class="preview-placeholder">
                            Please sign on device...
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(PreviewSignatureBase64))
                    {
                        <img src="@PreviewSignatureBase64"
                             class="full-preview-img" />
                    }
                    else
                    {
                        <div class="preview-placeholder">
                            Signature Preview
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

<style>

    .main-box {
        border: 1px solid #ccc;
        background: #f8f9fa;
    }

    .header {
        background-color: #2f5597;
        color: white;
        padding: 10px;
        font-weight: bold;
    }

    .signature-box {
        border: 2px solid #4a86e8;
        width: 100%;
        height: 220px;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .signature-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .capture-text {
        color: #666;
        font-weight: bold;
    }

    .preview-box {
        width: 220px;
        height: 60px;
        border: 2px solid #4a86e8;
        background: white;
        overflow: hidden;
    }

    .preview-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .full-preview-box {
        width: 100%;
        height: 220px;
        border: 2px solid #4a86e8;
        background-color: white;
        border-radius: 6px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .full-preview-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        padding: 10px;
    }

    .preview-placeholder {
        font-size: 16px;
        font-weight: 600;
        color: #666;
        text-align: center;
        padding: 10px;
    }

</style>

@code {

    private string? SignatureBase64;
    private string? PreviewSignatureBase64;
    private bool IsCapturing;

    private async Task CaptureSignature()
    {
        try
        {
            IsCapturing = true;

            StateHasChanged();

            string path =
                await signatureService.CaptureSignatureAsync();

            IsCapturing = false;
            string sig = Path.Combine(@"C:\Signature", "sig_Signature_.png");
            
            if (!string.IsNullOrEmpty(path) && File.Exists(sig))
            {
                byte[] bytes =
                    await File.ReadAllBytesAsync(sig);

                SignatureBase64 =
                    $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            IsCapturing = false;
        }
    }
    private async Task PreviewSignature()
    {
        try
        {
            

            IsCapturing = false;

            StateHasChanged();

            var bmp = await signatureService.PreviewSignatureAsync();
            if (bmp != null)
            {
                PreviewSignatureBase64 =
                    $"data:image/png;base64,{Convert.ToBase64String(bmp)}";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            IsCapturing = false;
        }
    }
    private Task ClearSignature()
    {
        SignatureBase64 = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

}