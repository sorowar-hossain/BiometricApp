@page "/signature"
@using BiometricApp.Services
@inject UserSessionService SessionService

@inject SignatureService signatureService

<div class="row mt-4">

    <!-- LEFT -->
    <div class="col-md-6 text-center">

        <div class="signature-box">

            @if (IsCapturing)
            {
                <div class="capture-text">
                    Waiting for signature...
                </div>
            }
            else if (!string.IsNullOrEmpty(LiveSignatureBase64))
            {
                <img src="@LiveSignatureBase64"
                     class="full-preview-img" />
            }
            else
            {
                <div class="capture-text">
                    No Signature
                </div>
            }

        </div>

        <!-- LEFT BUTTONS -->
        <div class="d-flex justify-content-center mt-4">

            <button class="btn btn-primary px-4 me-2 save-btn"
                    @onclick="CaptureSignature">
                <i class="bi bi-pen me-1"></i> Capture
            </button>

            <button class="btn btn-warning px-4 save-btn"
                    @onclick="ClearSignature"
                    disabled="@(isProcessing)">
                <i class="bi bi-arrow-repeat"></i> Retake
            </button>
            <button class="btn btn-success px-4 save-btn ms-4"
                    @onclick="SaveSignature"
                    disabled="@(isProcessing)">
                <i class="bi bi-check2-circle me-1"></i> Save
            </button>

        </div>

    </div>

    <!-- RIGHT -->
    <div class="col-md-6 text-center">

        <div class="full-preview-box">

            @if (IsCapturing)
            {
                <div class="preview-placeholder">
                    Please sign on device...
                </div>
            }
            else if (!string.IsNullOrEmpty(SignatureBase64))
            {
                <img src="@SignatureBase64"
                     class="full-preview-img" />
            }
            else
            {
                <div class="preview-placeholder">
                    Signature Preview
                </div>
            }

        </div>

        <!-- SAVE BUTTON -->
        <div class="d-flex justify-content-center mt-4">

          @*   <button class="btn btn-success px-5 save-btn"
                    @onclick="SaveSignature"
                    disabled="@(isProcessing)">
                <i class="bi bi-check2-circle me-1"></i> Save
            </button> *@

        </div>

    </div>

</div>

<style>

    .main-box {
        border: none;
        background: #f8f9fa;
        height:auto;
    }

    .header {
        background-color: #2f5597;
        color: white;
        padding: 10px;
        font-weight: bold;
    }

    .signature-box {
        width: 100%;
        max-width: 480px;
        height: 240px;
        border: 2px solid #1f4b99;
        border-radius: 12px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin: 0 auto;
    }

    .signature-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .capture-text {
        color: #666;
        font-weight: bold;
    }

    .preview-box {
        width: 220px;
        height: 60px;
        border: 2px solid #4a86e8;
        background: white;
        overflow: hidden;
    }

    .preview-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .full-preview-box {
        width: 100%;
        max-width: 480px;
        height: 240px;
        border: 2px solid #1f4b99;
        border-radius: 12px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin: 0 auto;
    }

    .full-preview-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        padding: 10px;
    }

    .preview-placeholder {
        font-size: 16px;
        font-weight: 600;
        color: #666;
        text-align: center;
        padding: 10px;
    }

</style>

@code {

    private string? LiveSignatureBase64;
    private string? SignatureBase64;
    private CancellationTokenSource? _cts;
    private bool IsCapturing = false;
    bool isProcessing = true;
    static string path = "";
    static string folder = "";
    private string PersonUniqueId = "";

    protected override async Task OnInitializedAsync()
    {
        isProcessing = true;
        IsCapturing = false;
        PersonUniqueId = SessionService.User.PersonUniqueId;
        path = Path.Combine(AppSettings.BaseFolder, PersonUniqueId);
        folder = Path.Combine(AppSettings.BaseFolder, PersonUniqueId);
    }

    private async Task CaptureSignature()
    {
        _cts = new CancellationTokenSource();

        LiveSignatureBase64 = null;

        StateHasChanged();

        // START LIVE PREVIEW LOOP
        _ = Task.Run(async () =>
        {
            await signatureService.StartLivePreviewAsync(
                frame =>
                {
                    LiveSignatureBase64 =
                        $"data:image/png;base64,{Convert.ToBase64String(frame)}";

                    InvokeAsync(StateHasChanged);
                },
                _cts.Token);
        });
        // START ACTUAL CAPTURE
        path = await signatureService.CaptureSignatureAsync(path);

        _cts.Cancel();

        if (!string.IsNullOrEmpty(path) && File.Exists(path))
        {
            isProcessing = false;
           
        }

        StateHasChanged();
    }

    private async Task SaveSignature()
    {

        if (File.Exists(path))
        {

            byte[] bytes = await File.ReadAllBytesAsync(path);

            SignatureBase64 =
                $"data:image/png;base64,{Convert.ToBase64String(bytes)}";

            await signatureService.SaveSignature(SignatureBase64, folder);

            path = Path.Combine(AppSettings.BaseFolder, PersonUniqueId);
        }

        StateHasChanged();
    }

    private async Task ClearSignature()
    {
        LiveSignatureBase64 = null;
        SignatureBase64 = null;
        path = Path.Combine(AppSettings.BaseFolder, PersonUniqueId); 
        isProcessing = true;
        StateHasChanged();
        
    }

}