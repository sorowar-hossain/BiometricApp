@page "/registration"
@using System.ComponentModel.DataAnnotations
@using BiometricApp.Services
@using BiometricApp.Models
@inject UserService UserService
@inject ApiService ApiService
@inject LocalStorageService LocalStorageService
@inject NavigationManager Navigation


<div class="container mt-4">

    <div class="card shadow-sm border-0">

      @*   <!-- HEADER -->
        <div class="card-header bg-primary text-white text-center fw-bold fs-5">
            Member Information
        </div> *@

        <div class="card-body p-4">

            <EditForm Model="model" OnValidSubmit="Save">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert alert-success py-2">
                        @message
                    </div>
                }

                <div class="row g-3">

                    <!-- Member ID -->
                    <div class="col-12">
                        <label class="form-label-custom">Member ID</label>
                        <InputText class="form-control custom-input" readonly @bind-Value="model.PersonUniqueId" />
                    </div>

                    <!-- First Name -->
                    <div class="col-md-6">
                        <label class="form-label-custom">First Name *</label>
                        <InputText class="form-control custom-input" @bind-Value="model.FirstName" placeholder="Enter First Name" />
                        <ValidationMessage For="@(() => model.FirstName)" />
                    </div>

                    <!-- Last Name -->
                    <div class="col-md-6">
                        <label class="form-label-custom">Last Name *</label>
                        <InputText class="form-control custom-input" @bind-Value="model.LastName" placeholder="Enter Last Name" />
                        <ValidationMessage For="@(() => model.LastName)" />
                    </div>

                    <!-- Marital Status -->
                    <div class="col-md-6">
                        <label class="form-label-custom">Marital Status *</label>
                        <InputSelect class="form-select custom-input" @bind-Value="model.MaritalStatus">
                            <option value="">Select</option>
                            <option>Single</option>
                            <option>Married</option>
                            <option>Divorced</option>
                            <option>Widowed</option>
                        </InputSelect>
                    </div>

                    <!-- DOB -->
                    <div class="col-md-6">
                        <label class="form-label-custom">Date of Birth *</label>
                        <InputDate class="form-control custom-input" @bind-Value="model.DateOfBirth" />
                    </div>

                    <!-- Gender -->
                    <div class="col-md-6">
                        <label class="form-label-custom">Gender *</label>
                        <InputSelect class="form-select custom-input" @bind-Value="model.Gender">
                            <option value="">Select</option>
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </InputSelect>
                    </div>

                    <!-- Expiry -->
                    <div class="col-md-6">
                        <label class="form-label-custom">Expiry Date *</label>
                        <InputDate class="form-control custom-input" @bind-Value="model.ExpiryDate" />
                    </div>

                    <!-- Parents -->
                    <div class="col-md-6">
                        <label class="form-label-custom">Father's Name *</label>
                        <InputText class="form-control custom-input" @bind-Value="model.FatherName" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-custom">Mother's Name *</label>
                        <InputText class="form-control custom-input" @bind-Value="model.MotherName" />
                    </div>

                    <!-- Address -->
                    <div class="col-12">
                        <label class="form-label-custom">Address *</label>
                        <InputTextArea class="form-control custom-input" rows="3" @bind-Value="model.Address" />
                    </div>

                    <!-- Optional -->
                    <div class="col-md-6">
                        <label class="form-label-custom">Place of Issue</label>
                        <InputText class="form-control custom-input" @bind-Value="model.PlaceOfIssue" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-custom">Place of Birth</label>
                        <InputText class="form-control custom-input" @bind-Value="model.PlaceOfBirth" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label-custom">Weight (kg)</label>
                        <InputNumber class="form-control custom-input" @bind-Value="model.Weight" />
                    </div>

                </div>

                <!-- BUTTONS -->
                <div class="d-flex justify-content-end mt-4 gap-2">

                    @if (isEditMode)
                    {
                        <button type="submit" class="btn btn-primary px-4">
                            Update
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success px-4" @onclick="SaveAndNext">
                            Save
                        </button>
                    }

                </div>

            </EditForm>

        </div>
    </div>
</div>

<style>
    .form-label-custom {
        font-size: 14px;
        font-weight: 600;
        color: #34495e;
        margin-bottom: 6px;
        display: block;
    }

    .custom-input {
        border-radius: 8px;
        border: 1px solid #dce3ea;
        padding: 10px 12px;
        transition: all 0.2s ease-in-out;
    }

        .custom-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.15);
        }

    .card {
        border-radius: 12px;
    }

    .card-header {
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
    }
</style>

@code {
    private MemberModel model = new();
    private UserLoginResponse user = new();
    private int Id;
    private string buttonText = "Save";
    string message = "";
    private bool isEditMode = false;
    protected override async Task OnInitializedAsync()
    {
        // Get current user
        user = UserService.CurrentUser;
        // var id = await ApiService.GetPersonUniqueIdAsync(user.OrgId);
        var id = CreateMemberId();
        model.PersonUniqueId = id;
        buttonText = "Save";
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        string? userId = query["id"];
        if (!string.IsNullOrEmpty(userId))
        {
            buttonText = "Update";
            model = await LocalStorageService.LoadDemographicsAsync(userId);
            isEditMode = true;
        }
        else
    {
        isEditMode = false;
    }
        StateHasChanged();
    }

    private async Task Save()
    {
        model.OrgId = user.OrgId;
        model.UserId = user.UserId;
        model.CreatedBy = user.UserName;

        if (buttonText == "Update")
        {
            await LocalStorageService.UpdateDemographicsAsync(model);
            buttonText = "Save";
            Navigation.NavigateTo($"/detail-review?id=" + model.PersonUniqueId + "");
        }
        else
        {
            var savePath = await LocalStorageService.SaveDemographicsAsync(model);
            message = "Member saved successfully to " + savePath;
            model = new MemberModel
            {
                PersonUniqueId = CreateMemberId()
            };
        }
      
        StateHasChanged();
        //bool result = await ApiService.CreateDemographicAsync(model);
    }
    private async Task SaveAndNext()
{
    model.OrgId = user.OrgId;
    model.UserId = user.UserId;
    model.CreatedBy = user.UserName;

    if (buttonText == "Update")
    {
        await LocalStorageService.UpdateDemographicsAsync(model);
    }
    else
    {
        await LocalStorageService.SaveDemographicsAsync(model);
    }

    //Redirect to face capture with ID
    Navigation.NavigateTo($"/face-capture?id={model.PersonUniqueId}");
}

    private int GetNextMemberSequence()
    {
        // Absolute path for members
        string baseFolder = AppSettings.BaseFolder;

        // Create the folder if it doesn't exist
        if (!Directory.Exists(baseFolder))
        {
            Directory.CreateDirectory(baseFolder);
            return 1; // no members yet
        }

        // Get all subfolders (each folder = one member)
        var allFolders = Directory.GetDirectories(baseFolder);

        if (allFolders.Length == 0)
            return 1; // no members yet

        // Count members created today (optional, or just use total folders)
        int maxSequence = 0;

        foreach (var folder in allFolders)
        {
            string jsonPath = Path.Combine(folder, "demographics.json");
            if (File.Exists(jsonPath))
            {
                var json = File.ReadAllText(jsonPath);
                var member = System.Text.Json.JsonSerializer.Deserialize<MemberModel>(json);
                if (member != null)
                {
                    // Extract last 6-7 digits from PersonUniqueId if your ID stores sequence
                    // Or simply count existing members and take max + 1
                    maxSequence++;
                }
            }
        }

        return maxSequence + 1; // next sequence number
    }


    private string CreateMemberId()
    {
        string userName = user.UserName;
        int seq = GetNextMemberSequence();

        // Format sequence as 6-digit or 7-digit number with leading zeros
        string seqStr = seq.ToString("D6"); // 000001, 000002, etc.

        // Include username + datetime + sequence
        string id = $"BIO.{userName}.{DateTime.Now:yyyyMMddHHmm}.{seqStr}";

        return id;
    }

  

}