@page "/registration"
@using System.ComponentModel.DataAnnotations
@using BiometricApp.Services
@using BiometricApp.Models
@inject UserService UserService
@inject ApiService ApiService
@inject LocalStorageService LocalStorageService
@inject NavigationManager Navigation
<div class="container mt-4">

    <!-- HEADER -->
    <div class="bg-primary text-white text-center p-3 fw-bold" style="font-size:20px;">
        Data Capturing System
    </div>

    <!-- MAIN BOX -->
    <div class="border p-4">

        <h5 class="fw-bold text-primary">Member Information</h5>
        <small class="text-muted">Member data is confidential and managed securely.</small>

        <EditForm Model="model" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row mt-4">
                <div class="col-md-12 mb-3">
                    @if (!string.IsNullOrEmpty(message))
                    {
                        <div class="alert alert-success">
                            @message
                        </div>
                    }
                    
                </div>

                <div class="col-md-12 mb-3">
                    <label>Member Id</label>
                    <InputText class="form-control" readonly  @bind-Value="model.PersonUniqueId" />
                    
                </div>

                <div class="col-md-6 mb-3">
                    <label>First Name *</label>
                    <InputText class="form-control" placeholder="Enter First Name" @bind-Value="model.FirstName" />
                    <ValidationMessage For="@(() => model.FirstName)" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Last Name *</label>
                    <InputText class="form-control" placeholder="Enter Last Name" @bind-Value="model.LastName" />
                    <ValidationMessage For="@(() => model.LastName)" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Marital Status *</label>
                    <InputSelect class="form-control" @bind-Value="model.MaritalStatus">
                        <option value="">Select Marital Status</option>
                        <option value="Single">Single</option>
                        <option value="Married">Married</option>
                        <option value="Divorced">Divorced</option>
                        <option value="Widowed">Widowed</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => model.MaritalStatus)" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Date of Birth *</label>
                    <InputDate class="form-control" @bind-Value="model.DateOfBirth" />
                    <ValidationMessage For="@(() => model.DateOfBirth)" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Gender *</label>
                    <InputSelect class="form-control" @bind-Value="model.Gender">
                        <option value="">Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => model.Gender)" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Expiry Date *</label>
                    <InputDate class="form-control" @bind-Value="model.ExpiryDate" />
                    <ValidationMessage For="@(() => model.ExpiryDate)" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Father's Name *</label>
                    <InputText class="form-control" placeholder="Enter Father's Name" @bind-Value="model.FatherName" />
                    <ValidationMessage For="@(() => model.FatherName)" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Mother's Name *</label>
                    <InputText class="form-control" placeholder="Enter Mother's Name" @bind-Value="model.MotherName" />
                    <ValidationMessage For="@(() => model.MotherName)" />
                </div>

                <div class="col-md-12 mb-3">
                    <label>Address *</label>
                    <InputTextArea class="form-control" placeholder="Enter your complete address" @bind-Value="model.Address" />
                    <ValidationMessage For="@(() => model.Address)" />
                </div>

                <!-- Optional Fields -->
                <div class="col-md-6 mb-3">
                    <label>Place Of Issue</label>
                    <InputText class="form-control" placeholder="Enter Place Of Issue" @bind-Value="model.PlaceOfIssue" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Place Of Birth</label>
                    <InputText class="form-control" placeholder="Enter Place Of Birth" @bind-Value="model.PlaceOfBirth" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Weight</label>
                    <InputNumber class="form-control" placeholder="Enter Weight (kg)" @bind-Value="model.Weight" />
                    <ValidationMessage For="@(() => model.Weight)" />
                </div>

            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-primary px-4">
                    @buttonText
                </button>
            </div>
        </EditForm>

    </div>
</div>

@code {
    private MemberModel model = new();
    private UserLoginResponse user = new();
    private int Id;
    private string buttonText = "Save";
    string message = "";
    protected override async Task OnInitializedAsync()
    {
        // Get current user
        user = UserService.CurrentUser;
        // var id = await ApiService.GetPersonUniqueIdAsync(user.OrgId);
        var id = CreateMemberId();
        model.PersonUniqueId = id;
        buttonText = "Save";
    }

    protected override async Task OnParametersSetAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        string? userId = query["id"];
        buttonText = "Update";
        if (!string.IsNullOrEmpty(userId))
        {
            model = await LocalStorageService.LoadDemographicsAsync(userId);
        }
        StateHasChanged();
    }

    private async Task Save()
    {
        model.OrgId = user.OrgId;
        model.UserId = user.UserId;
        model.CreatedBy = user.UserName;

        if (buttonText == "Update")
        {
            await LocalStorageService.UpdateDemographicsAsync(model);
            buttonText = "Save";
            Navigation.NavigateTo($"/detail-review?id=" + model.PersonUniqueId + "");
        }
        else
        {
            var savePath = await LocalStorageService.SaveDemographicsAsync(model);
            message = "Member saved successfully to " + savePath;
            model = new MemberModel
            {
                PersonUniqueId = CreateMemberId()
            };
        }
      
        StateHasChanged();
        //bool result = await ApiService.CreateDemographicAsync(model);
    }

    private int GetNextMemberSequence()
    {
        // Absolute path for members
        string baseFolder = AppSettings.BaseFolder;

        // Create the folder if it doesn't exist
        if (!Directory.Exists(baseFolder))
        {
            Directory.CreateDirectory(baseFolder);
            return 1; // no members yet
        }

        // Get all subfolders (each folder = one member)
        var allFolders = Directory.GetDirectories(baseFolder);

        if (allFolders.Length == 0)
            return 1; // no members yet

        // Count members created today (optional, or just use total folders)
        int maxSequence = 0;

        foreach (var folder in allFolders)
        {
            string jsonPath = Path.Combine(folder, "demographics.json");
            if (File.Exists(jsonPath))
            {
                var json = File.ReadAllText(jsonPath);
                var member = System.Text.Json.JsonSerializer.Deserialize<MemberModel>(json);
                if (member != null)
                {
                    // Extract last 6-7 digits from PersonUniqueId if your ID stores sequence
                    // Or simply count existing members and take max + 1
                    maxSequence++;
                }
            }
        }

        return maxSequence + 1; // next sequence number
    }


    private string CreateMemberId()
    {
        string userName = user.UserName;
        int seq = GetNextMemberSequence();

        // Format sequence as 6-digit or 7-digit number with leading zeros
        string seqStr = seq.ToString("D6"); // 000001, 000002, etc.

        // Include username + datetime + sequence
        string id = $"BIO.{userName}.{DateTime.Now:yyyyMMddHHmm}.{seqStr}";

        return id;
    }

  

}