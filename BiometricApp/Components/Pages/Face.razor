        background: #fff;
        border-radius: 12px;
        border: 1px solid #e9ecef;
        box-shadow: 0 2px 8px rgba(0,0,0,.08);
        overflow: hidden;
    }

        /* REMOVE ALL INTERNAL PADDING (KEY FIX) */
        .control-panel .analytics-content,
        .preview-panel .analytics-content,
        .analytics-card .analytics-content {
            padding: 10px !important;
        }

    /* =========================
       LIVE CAMERA + PREVIEW BOX
    ========================= */
