            width: 100%;
            height: 100%;
            display: block;
            object-fit: fill; /* exact same size as box */
        }
    .preview-box {
        position: relative;
        width: 100%;
        height: 320px;
        border: 1px solid #dcdcdc;
        border-radius: 10px;
        overflow: hidden;
        background: #f8f8f8;
        margin: 0;
