@page "/face-capture"
@inject UserSessionService SessionService

@using BiometricApp.Models
@using BiometricApp.Services
@using FaceONNX
@using Microsoft.ML.OnnxRuntime
@using Microsoft.ML.OnnxRuntime.Tensors
@using OpenCvSharp
@using System.Drawing
@using OpenCvSharp.Extensions
@using Windows.Media.FaceAnalysis;

@inject FaceCaptureHcService FaceCaptureService
@inject LocalStorageService LocalStorageService

<div class="container-fluid">

    <!-- HEADER -->
    @*    <div class="header-bar text-center">
        <h4>Biometric Enrollment System</h4>
    </div> *@

    <div class="row">

        <!-- LEFT PANEL -->
        <div class="col-lg-3 col-md-12 control-panel">

            <!-- CONTROLS -->
            <!-- CAMERA CONTROLS -->
            <div class="analytics-card">
                <div class="analytics-header">
                    <i class="bi bi-sliders"></i>
                    <h5>Camera Controls</h5>
                </div>

                <div class="analytics-content">

                    <!-- Auto Crop -->
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <button class="btn btn-success w-100"
                                    @onclick="EnableAutoCrop">
                                Enable Auto Crop
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-danger w-100"
                                    @onclick="DisableAutoCrop">
                                Disable Auto Crop
                            </button>
                        </div>
                    </div>

                    <!-- Rotation -->
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <button class="btn btn-primary w-100"
                                    @onclick="RotateLeft">
                                Rotate Left
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-primary w-100"
                                    @onclick="RotateRight">
                                Rotate Right
                            </button>
                        </div>
                    </div>

                    <!-- Zoom -->
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <button class="btn btn-primary w-100"
                                    @onclick="ZoomIn">
                                Zoom In
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-primary w-100"
                                    @onclick="ZoomOut">
                                Zoom Out
                            </button>
                        </div>
                    </div>

                    <!-- Resolution -->
                    <div class="mt-2">
                        <select class="form-select"
                                @onchange="ChangeResolution">
                            <option value="">Select Resolution</option>
                            <option value="0">640×480</option>
                            <option value="1">800×600</option>
                            <option value="2">1280×720</option>
                            <option value="3">1920×1080</option>
                        </select>
                    </div>

                </div>
            </div>

            <!-- FACE RECOGNITION -->
            <div class="analytics-card mt-4">
                <div class="analytics-header">
                    <i class="bi bi-person-bounding-box"></i>
                    <h5>Face Recognition</h5>
                </div>

                <div class="analytics-content">
                    <div class="analytics-item">
                        <span>Emotion</span>
                        <strong>Neutral</strong>
                    </div>

                    <div class="analytics-item">
                        <span>Confidence</span>
                        <strong>70%</strong>
                    </div>
                </div>
            </div>

            <!-- GENDER DETECTION -->
            <div class="analytics-card mt-3">
                <div class="analytics-header">
                    <i class="bi bi-gender-ambiguous"></i>
                    <h5>Gender Detection</h5>
                </div>

                <div class="analytics-content">
                    <div class="analytics-item">
                        <span>Male</span>
                        <strong>@Math.Round(FaceCaptureHcService._GenderMScore)%</strong>
                    </div>

                    <div class="analytics-item">
                        <span>Female</span>
                        <strong>@Math.Round(FaceCaptureHcService._GenderFScore)%</strong>
                    </div>
                </div>
            </div>


        </div>

        <!-- CENTER CAMERA -->
        <div class="col-lg-6 col-md-12">
            <div class="analytics-card mb-3">
                <div class="analytics-header">
                    <i class="bi bi-camera"></i>
                    <h5>Live Camera</h5>
                </div>
                <div class="analytics-content">
                    <div class="live-camera-box"> 

                        @if (CameraConnected && !string.IsNullOrEmpty(LiveImage))
                        {
                            <div class="live-camera-wrapper">

                                <img class="live-camera-img"
                                     src="@($"data:image/jpeg;base64,{LiveImage}")" />

                                <div class="face-box"
                                     style="
                                        left:@BoxLeft%;
                                        top:@BoxTop%;
                                        width:@BoxWidth%;
                                        height:@BoxHeight%;
                                     ">
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="camera-placeholder">
                                Camera Not Started
                            </div>
                        }

                    </div>
                    
                    <div class="camera-buttons mt-3">

                        <button class="btn btn-info save-btn"
                                @onclick="ToggleCamera">
                            @(CameraConnected ? "Close Camera" : "Start Camera")
                        </button>

                        <button class="btn btn-primary px-4 save-btn me-2"
                                @onclick="Capture"
                                disabled="@(!CameraConnected)">
                            <i class="bi bi-camera-fill"></i> Capture
                        </button>


                        <button class="btn btn-warning save-btn"
                                @onclick="Retake"
                                disabled="@string.IsNullOrEmpty(CapturedImage)">
                            <i class="bi bi-arrow-repeat"></i>Retake
                        </button>

                    </div>
                </div>
            </div>
            <div class="analytics-card mt-3">
                <div class="analytics-header">
                    <i class="bi bi-image"></i>
                    <h5>Image Quality Score: @FaceCaptureHcService._ImgQuality%</h5>
                </div>

                <div class="analytics-conten">
                    <div class="analytics-item">
                        <h8><strong>Brightness: @Math.Round(FaceCaptureHcService.brightness, 2)%</strong></h8>
                        <h8><strong>Sharpness: @Math.Round(FaceCaptureHcService.sharpness, 2)%</strong></h8>
                        <h8><strong>Contrast: @Math.Round(FaceCaptureHcService.contrast, 2)%</strong></h8>
                        <h8><strong>Face Size: @Math.Round(FaceCaptureHcService.faceSize, 2)%</strong></h8>
                        <h8><strong>Center: @Math.Round(FaceCaptureHcService.faceCenter, 2)%</strong></h8>
                    </div>
                </div>

            </div>

            <!-- EMOTION DETECTION -->
            <div class="analytics-card mt-3">
                <div class="analytics-header">
                    <i class="bi bi-emoji-smile"></i>
                    <h5>Emotion Detection</h5>
                </div>

                <div class="analytics-content emotion-grid">

                    <div class="emotion-column">
                        <div class="analytics-item">
                            <span>Happy</span>
                            <strong>@FaceCaptureHcService._HappyEmoScore%</strong>
                        </div>

                        <div class="analytics-item">
                            <span>Sad</span>
                            <strong>@FaceCaptureHcService._SadEmoScore%</strong>
                        </div>
                    </div>

                    <div class="emotion-column">
                        <div class="analytics-item">
                            <span>Angry</span>
                            <strong>@FaceCaptureHcService._AngryEmoScore%</strong>
                        </div>

                        <div class="analytics-item">
                            <span>Surprised</span>
                            <strong>@FaceCaptureHcService._SurpriseEmoScore%</strong>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- RIGHT PREVIEW -->
        <div  class="col-lg-3 col-md-12 preview-panel px-0">
            <div class="analytics-card">
                <div class="analytics-header">
                    <i class="bi bi-person-circle"></i>
                    <h5>Captured Face</h5>
                </div>
                <div class="analytics-content">
                    <div class="preview-box">

                        @if (!string.IsNullOrEmpty(CapturedImage))
                        {
                            <img class=""
                                 src="@($"data:image/jpeg;base64,{CapturedImage}")" />
                        }
                        else
                        {
                            <div class="camera-placeholder">
                                No Captured Image
                            </div>
                        }

                    </div>

                    <div class="d-flex justify-content-start mt-2">
                        <div class="d-flex justify-content-center mt-2">
                            <button class="btn btn-success save-btn custom-save-btn"
                                    @onclick="SaveFace"
                                    disabled="@string.IsNullOrEmpty(CapturedImage)">
                                <i class="bi bi-check2-circle me-1"></i>Save Photo
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="analytics-card status-box mt-4">
                <div class="analytics-header">
                    <i class="bi bi-check-circle-fill"></i>
                    Status
                </div>
                <div class="analytics-content">
                    <div class="analytics-item">
                        <h6>@Status</h6>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

@code {

    private List<MemberDropdown> members = new();
    [Parameter]
    public EventCallback<string> OnActionMessage { get; set; }
    private string selectedMemberId;

    private bool CameraConnected;

    private string LiveImage;
    private byte[] faceImageBytes;

    private string CapturedImage;

    private string Status = "Idle";
    string path = "";

    private System.Timers.Timer _uiTimer;
    private float BoxLeft;
    private float BoxTop;
    private float BoxWidth;
    private float BoxHeight;

    protected override async Task OnInitializedAsync()
    {
        selectedMemberId = SessionService.User.PersonUniqueId;
        path = AppSettings.BaseFolder;

        //members = await LocalStorageService.GetMembersForDropdownAsync();
    }

    async Task ToggleCamera()
    {
        try
        {
            if (!CameraConnected)
            {
                FaceCaptureService.StartCamera();

                CameraConnected = true;

                Status = "Camera Started";
            }
            else
            {
                FaceCaptureService.StopCamera();

                CameraConnected = false;

                LiveImage = null;

                CapturedImage = null;

                Status = "Camera Closed";
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Status = ex.Message;
        }
    }
    async Task Capture()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(selectedMemberId))
            {
                Status = "Member not found..!";
                return;
            }

            var resImage = FaceCaptureService.CaptureFace();
            CapturedImage = await FaceCaptureService.RemoveBackground(resImage);
            Status = "Face Captured";



            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Status = ex.Message;
        }
    }

    void Retake()
    {
        CapturedImage = null;
        FaceCaptureHcService._ImgQuality = 0.0;

        Status = "Retake Image";
    }

    async Task SaveFace()
    {
        try
        {
            if (string.IsNullOrEmpty(CapturedImage))
                return;
            string folder = Path.Combine(path, selectedMemberId);

            await FaceCaptureService.SaveFace(CapturedImage, folder);

            Status = "Photo Saved Successfully";
            await OnActionMessage.InvokeAsync(Status);
        }
        catch (Exception ex)
        {
            Status = ex.Message;
        }
    }
    private Mat? DetectFace_bak(Mat frame)
    {
        using Bitmap bitmap = BitmapConverter.ToBitmap(frame);

        var faces = FaceCaptureHcService._detector.Forward(bitmap);

        if (faces == null || faces.Length == 0)
            return null;

        var face = faces[0];

        var r = face.Rectangle;

        var rect = new OpenCvSharp.Rect(
            r.X,
            r.Y,
            r.Width,
            r.Height);

        rect = rect & new OpenCvSharp.Rect(
            0,
            0,
            frame.Width,
            frame.Height);

        if (rect.Width <= 0 || rect.Height <= 0)
            return null;

        return new Mat(frame, rect).Clone();
    }

    private FaceResult? DetectFace(Mat frame)
    {
        using Bitmap bitmap = BitmapConverter.ToBitmap(frame);

        var faces = FaceCaptureHcService._detector.Forward(bitmap);

        if (faces == null || faces.Length == 0)
            return null;

        var r = faces[0].Rectangle;

        var rect = new OpenCvSharp.Rect(r.X, r.Y, r.Width, r.Height);

        rect = rect & new OpenCvSharp.Rect(0, 0, frame.Width, frame.Height);

        if (rect.Width <= 0 || rect.Height <= 0)
            return null;

        return new FaceResult
        {
            Rect = rect,
            Face = new Mat(frame, rect).Clone()
        };
    }

    private Dictionary<string, float> GetEmotionPercentages(Mat face)
    {
        Cv2.ImEncode(".jpg", face, out byte[] imageBytes);
        var tensor = Preprocess(imageBytes);

        var inputs = new List<NamedOnnxValue>
    {
        NamedOnnxValue.CreateFromTensor(
            FaceCaptureHcService._emotion.InputMetadata.Keys.First(),
            tensor)
    };

        using var result = FaceCaptureHcService._emotion.Run(inputs);

        var output = result.First().AsEnumerable<float>().ToArray();

        string[] labels =
        {
        "Angry",
        "Contempt",
        "Disgust",
        "Fear",
        "Happy",
        "Neutral",
        "Sad",
        "Surprise"
    };
        var probabilities = Softmax(output);

        return labels
            .Select((label, index) => new
            {
                Label = label,
                Percentage = probabilities[index] * 100f
            })
            .ToDictionary(x => x.Label, x => x.Percentage);
    }
    private DenseTensor<float> Preprocess(byte[] imageBytes)
    {
        using var face = Cv2.ImDecode(imageBytes, ImreadModes.Grayscale);

        using var resized = new Mat();
        Cv2.Resize(face, resized, new OpenCvSharp.Size(64, 64));

        var tensor = new DenseTensor<float>(new[] { 1, 1, 64, 64 });

        for (int y = 0; y < 64; y++)
        {
            for (int x = 0; x < 64; x++)
            {
                tensor[0, 0, y, x] =
                    resized.At<byte>(y, x) / 255.0f;
            }
        }

        return tensor;
    }
    private float[] Softmax(float[] values)
    {
        float max = values.Max();

        var exp = values
            .Select(v => MathF.Exp(v - max))
            .ToArray();

        float sum = exp.Sum();

        return exp
            .Select(v => v / sum)
            .ToArray();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _uiTimer = new System.Timers.Timer(200);
            _uiTimer.AutoReset = true;
            _uiTimer.Enabled = true;

            _uiTimer.Elapsed += async (s, e) =>
            {
                if (!CameraConnected)
                    return;

                var base64 = FaceCaptureService.GetLiveBase64();

                if (string.IsNullOrWhiteSpace(base64))
                    return;

                await InvokeAsync(() =>
                {
                    LiveImage = FaceCaptureService.GetLiveBase64();
                    StateHasChanged();
                });

                var imgBytes = Convert.FromBase64String(base64);

                FaceCaptureHcService._ImgQuality =
                    Math.Round(FaceCaptureHcService.CalculateQualityPercentage(imgBytes));

                Mat frame = Cv2.ImDecode(imgBytes, ImreadModes.Color);

                var faceResult = DetectFace(frame);

                if (faceResult != null)
                {
                    var r = faceResult.Rect;

                    // ✅ GREEN BOX CALCULATION (IMPORTANT)
                    BoxLeft = (float)r.X / frame.Width * 100;
                    BoxTop = (float)r.Y / frame.Height * 100;
                    BoxWidth = (float)r.Width / frame.Width * 100;
                    BoxHeight = (float)r.Height / frame.Height * 100;

                    var Emores = GetEmotionPercentages(faceResult.Face);

                    foreach (var item in Emores)
                    {
                        switch (item.Key.ToLower())
                        {
                            case "angry":
                                FaceCaptureHcService._AngryEmoScore = Math.Round(item.Value);
                                break;

                            case "happy":
                                FaceCaptureHcService._HappyEmoScore = Math.Round(item.Value);
                                break;

                            case "sad":
                                FaceCaptureHcService._SadEmoScore = Math.Round(item.Value);
                                break;

                            case "surprise":
                                FaceCaptureHcService._SurpriseEmoScore = Math.Round(item.Value);
                                break;
                        }
                    }

                    var gender = FaceCaptureHcService.GetGender(faceResult.Face);

                    if (gender.ToLower() == "male")
                    {
                        FaceCaptureHcService._GenderMScore = 99.0;
                        FaceCaptureHcService._GenderFScore = 0.0;
                    }
                    else if (gender.ToLower() == "female")
                    {
                        FaceCaptureHcService._GenderMScore = 0.0;
                        FaceCaptureHcService._GenderFScore = 99.0;
                    }
                }

                await InvokeAsync(StateHasChanged);
            };

            _uiTimer.Start();
        }
    }

    void RotateLeft()
    {
        FaceCaptureService.RotateLeft();

        Status = "Rotated Left";
    }

    void RotateRight()
    {
        FaceCaptureService.RotateRight();

        Status = "Rotated Right";
    }

    void ZoomIn()
    {
        FaceCaptureService.ZoomIn();

        Status = "Zoom In";
    }

    void ZoomOut()
    {
        FaceCaptureService.ZoomOut();

        Status = "Zoom Out";
    }

    void EnableAutoCrop()
    {
        FaceCaptureService.SetAutoCrop(true);

        Status = "Auto Crop Enabled";
    }

    void DisableAutoCrop()
    {
        FaceCaptureService.SetAutoCrop(false);

        Status = "Auto Crop Disabled";
    }

    async Task ChangeResolution(ChangeEventArgs e)
    {
        try
        {
            if (e.Value == null)
                return;

            int resIndex =
                Convert.ToInt32(e.Value);

            FaceCaptureService
                .SetResolution(resIndex);

            Status =
                $"Resolution Changed";

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Status = ex.Message;
        }
    }

    public void Dispose()
    {
        _uiTimer?.Stop();

        _uiTimer?.Dispose();

        FaceCaptureService.StopCamera();
    }
}

<style>
