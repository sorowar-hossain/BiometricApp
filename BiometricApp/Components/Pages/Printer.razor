@page "/printer-test"
@using FingerprintWrapper
@using System.Text
@inject IJSRuntime JS

<h3>Printer Test</h3>

<button class="btn btn-primary" @onclick="TestPrint">
    Test Printer
</button>



<p>@status</p>

@code {
    private string status = "";
    bool faceCaptured = false;
    bool fingerCaptured = false;
    bool irisCaptured = false;
    bool signatureCaptured = false;

    private IMDPrinter printer = new IMDPrinter();



    private async Task TestPrint()
    {
        try
        {
            status = "Connecting...";
            StateHasChanged();

            int conn = printer.AutoConnectUSB();
            if (conn != 0)
            {
                status = "USB connection failed: " + conn;
                return;
            }

            var res=  printer.Init();
            await Task.Delay(500);

            status = "Printing...";
            StateHasChanged();

            var sb = await GetData();

            var res3 = printer.PrintText(sb.ToString());
            var res7 = printer.PrintLine(2);

            var res8 = printer.PrintQRCode("TEST123");
            var res11 = printer.PrintLine(7);

            var res9 = printer.CutPaper();

            await Task.Delay(1000); // VERY IMPORTANT

            var res10 = printer.Close();

            status = "Print sent successfully";
        }
        catch (Exception ex)
        {
            status = "Error: " + ex.Message;
        }
    }


    private async Task<StringBuilder> GetData()
    {
        var sb = new StringBuilder();

        sb.AppendLine("================================");
        sb.AppendLine("        GOV REGISTRATION        ");
        sb.AppendLine("================================");
        sb.AppendLine("Office: Kaliganj Service Center");
        sb.AppendLine("Date  : " + DateTime.Now.ToString("dd-MMM-yyyy HH:mm"));
        sb.AppendLine("--------------------------------");

        // USER INFO SECTION
        sb.AppendLine("Applicant Information");
        sb.AppendLine("--------------------------------");
        sb.AppendLine("Name        : " + "Amin");
        sb.AppendLine("Father Name : " + "Father Name Here");
        sb.AppendLine("Mother Name : " + "Mother Name Here");
        sb.AppendLine("Gender      : " + "Male");
        sb.AppendLine("DOB         : " + DateTime.Now.ToString("dd-MMM-yyyy"));
        sb.AppendLine("Expiry Date : " + DateTime.Now.AddYears(10).ToString("dd-MMM-yyyy"));
        sb.AppendLine("--------------------------------");

        // BIOMETRIC CAPTURE STATUS
        sb.AppendLine("Biometric Capture Status");
        sb.AppendLine("--------------------------------");

        sb.AppendLine("Face        : " + (faceCaptured ? "SUCCESS" : "FAILED"));
        sb.AppendLine("Fingerprint : " + (fingerCaptured ? "SUCCESS" : "FAILED"));
        sb.AppendLine("Iris        : " + (irisCaptured ? "SUCCESS" : "FAILED"));
        sb.AppendLine("Signature   : " + (signatureCaptured ? "SUCCESS" : "FAILED"));

        sb.AppendLine("--------------------------------");

     

        sb.AppendLine("This is an automated system generated slip.");
        sb.AppendLine("Keep this for future reference.");

        sb.AppendLine("================================");
        sb.AppendLine("     THANK YOU / PLEASE VISIT     ");
        sb.AppendLine("================================");

        return sb;
    }
}



